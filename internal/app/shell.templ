package app

import (
	"iworkflow/internal/core/components"
	"iworkflow/internal/core/dock"
	"iworkflow/internal/core/dock/link"
	"iworkflow/internal/core/i18n"
	"iworkflow/internal/core/web"
	agentsettingscomponents "iworkflow/internal/modules/agent_settings/presentation/components"
	prefspages "iworkflow/internal/modules/preferences/presentation/pages"
)

// shellPage is the full document of a page visit: the sidebar, the dock that hosts the tabs, the
// notifications and the first-run language prompt. boardSidebar is the board part of the sidebar.
templ shellPage(boardSidebar templ.Component) {
	@web.Shell(msgBrand.T(ctx)) {
		<div hx-ext="sse" sse-connect="/api/tasks/events" class="contents">
			@components.AppShell(components.AppShellProps{
				Brand:   msgBrand.T(ctx),
				Sidebar: sidebar(boardSidebar),
				Content: dock.Placeholder(),
			})
		</div>
		@components.ToastStack()
		@prefspages.LanguagePromptSection(i18n.StateFrom(ctx).Chosen)
		<script type="module" src="/static/js/ui.js"></script>
		<script type="module" src="/static/js/transcript.js"></script>
		<script type="module" src="/static/js/dock.js"></script>
		<script type="module" src="/static/js/task_form.js"></script>
		<script type="module" src="/static/js/graph.js"></script>
		<script type="module" src="/static/js/code.js"></script>
	}
}

// sidebar is the sidebar content: brand, the navigation of the migrated screens, the board lists and the footer.
templ sidebar(boardSidebar templ.Component) {
	<div class="flex shrink-0 items-center gap-2 px-3 pt-3 pb-1">
		<span class="live-dot text-accent" aria-hidden="true"></span>
		@link.Tab(link.Props{Href: "/", Class: "flex-1 text-sm font-semibold tracking-tight"}) {
			{ msgBrand.T(ctx) }
		}
		@components.SidebarToggle(components.SidebarToggleProps{Class: "hidden md:flex"})
	</div>
	<div class="min-h-0 flex-1 overflow-y-auto overflow-x-hidden">
		@components.SidebarSection(components.SidebarSectionProps{Title: msgMenu.T(ctx), Count: len(navEntries)}) {
			<nav class="flex flex-col gap-0.5" aria-label={ msgNavigation.T(ctx) }>
				for _, entry := range navEntries {
					@link.Tab(link.Props{Href: entry.Href, Class: "sidebar-nav"}) {
						<span class="sidebar-nav-icon" aria-hidden="true">{ entry.Icon }</span>
						{ entry.Title(ctx) }
					}
				}
			</nav>
		}
		@boardSidebar
	</div>
	<div class="stack shrink-0 border-t border-border p-2.5">
		@agentsettingscomponents.AgentSettingsBarPlaceholder()
	</div>
}

// launcherEntries is the entry list of the "+" menu of a group.
templ launcherEntries() {
	for _, entry := range navEntries {
		@link.Tab(link.Props{Href: entry.Href, Class: "menu-item"}) {
			<span class="mr-2 inline-block w-4 text-center text-muted" aria-hidden="true">{ entry.Icon }</span>
			{ entry.Title(ctx) }
		}
	}
}

// emptyGroupBody is the body of a group without tabs: a hint and the launcher.
templ emptyGroupBody() {
	<div class="absolute inset-0 flex flex-col items-center justify-center gap-4 p-6 text-center">
		<p class="text-sm text-muted">{ msgEmptyGroup.T(ctx) }</p>
		<div class="flex flex-col">
			@launcherEntries()
		</div>
	</div>
}

// notMigratedPane is the body of a screen that the Go server does not serve yet.
templ notMigratedPane() {
	<div class="flex h-full items-center justify-center p-6 text-center">
		<p class="text-sm text-muted">{ msgNotMigrated.T(ctx) }</p>
	</div>
}
