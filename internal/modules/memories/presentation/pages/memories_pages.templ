package pages

import (
	shared "iworkflow/internal/core/components"
	"iworkflow/internal/core/dock/link"
	"iworkflow/internal/modules/memories/presentation/state"
)

// MemoriesPage lists the memories of a workspace. It is read only: rows only link to the reader.
templ MemoriesPage(page state.ListPage) {
	<div class="flex h-full min-h-0 flex-col" data-memories-list>
		<div class="flex shrink-0 flex-wrap items-center justify-between gap-2 border-b border-border bg-surface px-4 py-2.5">
			<h1 class="page-title">{ msgMemoriesTitle.T(ctx) } · @shared.WorkspaceLabel(page.WorkspaceName, page.WorkspaceColor)</h1>
			<div class="row gap-2">
				<span class="badge">{ msgReadOnly.T(ctx) }</span>
				@link.Tab(link.Props{Href: page.BoardHref, Class: "btn-secondary min-h-9 rounded-lg px-2.5 py-1 text-xs"}) {
					{ msgBackToBoard.T(ctx) }
				}
			</div>
		</div>
		<div class="stack min-h-0 flex-1 overflow-y-auto p-4">
			switch page.Availability {
				case state.Unavailable:
					<p class="muted" role="status">{ msgUnavailable.T(ctx) }</p>
				case state.Empty:
					<p class="muted" role="status">{ msgEmpty.T(ctx) }</p>
				default:
					@memoryRows(page.Rows)
			}
		</div>
	</div>
}

// MemoryPage shows one memory with its content rendered as Markdown. Raw HTML in it is shown escaped and unsafe links are neutralized.
templ MemoryPage(page state.DetailPage) {
	<div class="flex h-full min-h-0 flex-col" data-memory-detail>
		<div class="flex shrink-0 flex-wrap items-center justify-between gap-2 border-b border-border bg-surface px-4 py-2.5">
			<h1 class="page-title truncate">{ page.Title }</h1>
			<div class="row gap-2">
				<span class="badge">{ msgReadOnly.T(ctx) }</span>
				@link.Tab(link.Props{Href: page.ListHref, Class: "btn-secondary min-h-9 rounded-lg px-2.5 py-1 text-xs"}) {
					{ msgBackToList.T(ctx) }
				}
			</div>
		</div>
		<div class="stack min-h-0 flex-1 overflow-y-auto p-4">
			if page.Availability == state.Unavailable {
				<p class="muted" role="status">{ msgUnavailable.T(ctx) }</p>
			} else {
				<p class="text-xs text-muted">@shared.WorkspaceLabel(page.WorkspaceName, page.WorkspaceColor) · { page.Type } · { page.Date }</p>
				<div class="markdown break-words text-sm text-fg" data-memory-content>@templ.Raw(markdownHTML(page.Content))</div>
			}
		</div>
	</div>
}

// memoryRows lists memories as cards. The whole card is the link to the reader, so any tap on it opens the memory.
templ memoryRows(rows []state.Row) {
	<ul class="stack gap-2">
		for _, row := range rows {
			<li data-memory-row>
				@link.Tab(link.Props{Href: row.Href, Class: "card stack gap-0.5 hover:border-accent"}) {
					<span class="truncate font-medium text-fg">{ row.Title }</span>
					<span class="text-xs text-muted">{ row.Type } · { row.Date }</span>
				}
			</li>
		}
	</ul>
}

// TaskMemoriesPage shows the memories of a task's workspace in two groups: the ones written since the task started
// (its branch) and the earlier ones. It is read only.
templ TaskMemoriesPage(page state.TaskPage) {
	<div class="flex h-full min-h-0 flex-col" data-task-memories>
		<div class="flex shrink-0 flex-wrap items-center justify-between gap-2 border-b border-border bg-surface px-4 py-2.5">
			<div class="stack min-w-0 gap-0">
				<h1 class="page-title truncate">{ msgMemoriesTitle.T(ctx) } · { page.TaskTitle }</h1>
				<code class="truncate font-mono text-xs text-muted">{ page.Branch }</code>
			</div>
			<div class="row gap-2">
				<span class="badge">{ msgReadOnly.T(ctx) }</span>
				@link.Tab(link.Props{Href: page.TaskHref, Class: "btn-secondary min-h-9 rounded-lg px-2.5 py-1 text-xs"}) {
					{ msgBackToTask.T(ctx) }
				}
				@link.Tab(link.Props{Href: page.ListHref, Class: "btn-secondary min-h-9 rounded-lg px-2.5 py-1 text-xs"}) {
					{ msgAllWorkspace.T(ctx) }
				}
			</div>
		</div>
		<div class="stack min-h-0 flex-1 gap-4 overflow-y-auto p-4">
			switch page.Availability {
				case state.Unavailable:
					<p class="muted" role="status">{ msgUnavailable.T(ctx) }</p>
				case state.Empty:
					<p class="muted" role="status">{ msgEmpty.T(ctx) }</p>
				default:
					<section class="stack gap-2" data-memory-group="branch">
						<h2 class="eyebrow">{ msgBranchGroup.T(ctx) }</h2>
						<p class="muted text-sm">{ msgBranchHelp.T(ctx) }</p>
						if len(page.BranchRows) == 0 {
							<p class="muted text-sm" data-memory-group-empty>{ msgNoBranchYet.T(ctx) }</p>
						} else {
							@memoryRows(page.BranchRows)
						}
					</section>
					if len(page.EarlierRows) > 0 {
						<section class="stack gap-2" data-memory-group="earlier">
							<h2 class="eyebrow">{ msgEarlierGroup.T(ctx) }</h2>
							<p class="muted text-sm">{ msgEarlierHelp.T(ctx) }</p>
							@memoryRows(page.EarlierRows)
						</section>
					}
			}
		</div>
	</div>
}
