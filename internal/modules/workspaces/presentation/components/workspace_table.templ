package components

import (
	shared "iworkflow/internal/core/components"
	"iworkflow/internal/core/dock/link"
	"iworkflow/internal/modules/workspaces/presentation/state"
)

// WorkspaceTable lists the registered workspaces as cards. Deleting one swaps the whole table, so the
// response carries the new list and the error of the attempt, if any.
templ WorkspaceTable(table state.TableView) {
	<div id="workspace-table" class="stack" { oobAttributes(table.OutOfBand)... }>
		if table.Error != "" {
			@shared.ErrorText(table.Error)
		}
		if len(table.Rows) == 0 {
			<p class="muted">{ msgNoWorkspaces.T(ctx) }</p>
		} else {
			<div class="stack sm:hidden">
				for _, row := range table.Rows {
					<article class="card stack gap-1.5 animate-slide-up">
						<div class="row justify-between">
							<span class="font-medium text-fg">
								<span class="mr-1.5 inline-block h-2 w-2 rounded-full bg-accent"></span>
								{ row.Name }
							</span>
							<div class="row gap-1.5">
								@link.Tab(link.Props{Href: row.EditHref, Class: "btn-secondary min-h-9 rounded-lg px-2.5 py-1 text-xs"}) {
									{ msgEdit.T(ctx) }
								}
								@link.Tab(link.Props{Href: row.TerminalHref, Class: "btn-secondary min-h-9 rounded-lg px-2.5 py-1 text-xs"}) {
									{ msgOpenTerminal.T(ctx) }
								}
								<button
									type="button"
									class="btn-danger min-h-9 rounded-lg px-2.5 py-1 text-xs"
									hx-post={ "/workspaces/" + row.ID + "/delete" }
									hx-confirm={ msgConfirmRemove.Fmt(ctx, map[string]string{"name": row.Name}) }
									hx-target="#workspace-table"
									hx-swap="outerHTML"
								>{ msgRemove.T(ctx) }</button>
							</div>
						</div>
						<code class="truncate font-mono text-xs text-muted">{ row.Path }</code>
						<code class="font-mono text-xs text-muted">{ row.BaseBranch }</code>
					</article>
				}
			</div>
		}
	</div>
}
