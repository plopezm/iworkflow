package components

import (
	shared "iworkflow/internal/core/components"
	"iworkflow/internal/core/dock/link"
	"iworkflow/internal/modules/workspaces/presentation/state"
)

// WorkspaceTable lists the registered workspaces as cards. Deleting one swaps the whole table, so the
// response carries the new list and the error of the attempt, if any.
templ WorkspaceTable(table state.TableView) {
	<div
		id="workspace-table"
		class="stack"
		hx-get="/workspaces/table"
		hx-trigger="sse:changed delay:250ms, sse:removed delay:250ms, sse:reset delay:250ms, board:refresh from:body, htmx:afterRequest[event.detail.requestConfig.verb == 'post' && event.detail.pathInfo.requestPath.startsWith('/workspaces')] from:body delay:250ms"
		hx-sync="this:replace"
		hx-target="this"
		hx-swap="morph:innerHTML"
		hx-disinherit="hx-swap hx-target"
		{ oobAttributes(table.OutOfBand)... }
	>
		@WorkspaceTableBody(table)
	</div>
}

// WorkspaceTableBody is the content of the table. It is what /workspaces/table answers: the element that listens
// for changes stays in the page and only this content is morphed.
templ WorkspaceTableBody(table state.TableView) {
	<div class="stack">
		if table.Error != "" {
			@shared.ErrorText(table.Error)
		}
		if len(table.Rows) == 0 {
			<p class="muted">{ msgNoWorkspaces.T(ctx) }</p>
		} else {
			<div class="stack">
				for _, row := range table.Rows {
					<article class="card stack gap-1.5 animate-slide-up">
						<div class="row justify-between">
							<span class="font-medium text-fg">
								if shared.WorkspaceColorClass(row.Color) == "" {
									<span class="mr-1.5 inline-block h-2 w-2 rounded-full bg-accent"></span>
								}
								@shared.WorkspaceName(row.Name, row.Color)
								if row.GroupName != "" {
									<span class="ml-2 text-xs font-normal text-muted" data-workspace-group>
										@shared.WorkspaceName(row.GroupName, row.GroupColor)
									</span>
								}
							</span>
							<div class="row gap-1.5">
								@link.Tab(link.Props{Href: row.BoardHref, Class: "btn-primary min-h-9 rounded-lg px-2.5 py-1 text-xs"}) {
									{ msgOpenBoard.T(ctx) }
								}
								@link.Tab(link.Props{Href: row.EditHref, Class: "btn-secondary min-h-9 rounded-lg px-2.5 py-1 text-xs"}) {
									{ msgEdit.T(ctx) }
								}
								@link.Tab(link.Props{Href: row.FilesHref, Class: "btn-secondary min-h-9 rounded-lg px-2.5 py-1 text-xs"}) {
									{ msgFiles.T(ctx) }
								}
								@link.Tab(link.Props{Href: row.MemoriesHref, Class: "btn-secondary min-h-9 rounded-lg px-2.5 py-1 text-xs"}) {
									{ msgMemories.T(ctx) }
								}
								@link.Tab(link.Props{Href: row.TerminalHref, Class: "btn-secondary min-h-9 rounded-lg px-2.5 py-1 text-xs"}) {
									{ msgOpenTerminal.T(ctx) }
								}
								@link.Tab(link.Props{Href: row.BranchesHref, Class: "btn-secondary min-h-9 rounded-lg px-2.5 py-1 text-xs"}) {
									{ msgBranches.T(ctx) }
								}
								<button
									type="button"
									class="btn-danger min-h-9 rounded-lg px-2.5 py-1 text-xs"
									hx-post={ "/workspaces/" + row.ID + "/delete" }
									hx-confirm={ msgConfirmRemove.Fmt(ctx, map[string]string{"name": row.Name}) }
									hx-target="#workspace-table"
									hx-swap="outerHTML"
								>{ msgRemove.T(ctx) }</button>
							</div>
						</div>
						<code class="truncate font-mono text-xs text-muted">{ row.Path }</code>
						<code class="font-mono text-xs text-muted">{ row.BaseBranch }</code>
						if row.Memory.State != state.MemoryChipHidden {
							<div class="row">
								<span class={ memoryChipClass(row.Memory) }>{ memoryChipText(ctx, row.Memory) }</span>
							</div>
						}
					</article>
				}
			</div>
		}
	</div>
}
