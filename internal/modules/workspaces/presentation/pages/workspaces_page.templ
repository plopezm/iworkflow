package pages

import (
	shared "iworkflow/internal/core/components"
	"iworkflow/internal/modules/workspaces/presentation/components"
	"iworkflow/internal/modules/workspaces/presentation/state"
)

// WorkspacesPage is the workspaces tab: registration, the folder picker and the list.
templ WorkspacesPage(page state.WorkspacesPage) {
	<div class="flex h-full min-h-0 flex-col">
		<div class="flex shrink-0 items-center border-b border-border bg-surface px-4 py-2.5">
			<h1 class="page-title">{ msgWorkspacesTitle.T(ctx) }</h1>
		</div>
		<div class="stack min-h-0 flex-1 overflow-y-auto p-4">
			@shared.Card(msgRegisterTitle.T(ctx)) {
				@components.WorkspaceRegister(page.Form)
			}
			@components.DirectoryPicker(state.DirectoryPicker{})
			@shared.Card(msgRegisteredTitle.T(ctx)) {
				@components.WorkspaceTable(page.Table)
			}
		</div>
	</div>
}
