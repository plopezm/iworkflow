package pages

import (
	shared "iworkflow/internal/core/components"
	"iworkflow/internal/core/dock/link"
	"iworkflow/internal/modules/workspaces/presentation/state"
)

// WorkspaceEditPage is the edit tab of one workspace. A successful save replaces the tab with the list.
templ WorkspaceEditPage(page state.EditPage) {
	<div class="h-full min-h-0 overflow-y-auto">
		<div class="mx-auto w-full max-w-3xl p-4 pb-10 md:p-6 md:pb-12">
			@EditGroupsLazy(page.ID)
			<form class="card stack gap-4 p-5 md:p-6" hx-post={ "/workspaces/" + page.ID + "/update" } hx-target="#workspace-edit-result" hx-swap="innerHTML">
				<h1 class="page-title">{ msgEditTitle.T(ctx) }</h1>
				@shared.TextField(shared.FieldProps{Label: msgNameLabel.T(ctx), Name: "name", Value: page.Name, Placeholder: msgNamePlaceholder.T(ctx), Required: true})
				<div class="stack gap-1.5">
					<span class="text-sm font-medium text-fg">{ msgPathLabel.T(ctx) }</span>
					<code class="truncate font-mono text-xs text-muted">{ page.Path }</code>
				</div>
				@shared.ColorPicker(shared.ColorPickerProps{Label: msgColorLabel.T(ctx), NoneLabel: msgNoColorLabel.T(ctx), Name: "color", Value: page.Color})
				@shared.TextField(shared.FieldProps{Label: msgBaseBranchLabel.T(ctx), Name: "base_branch", Value: page.BaseBranch, Placeholder: "main"})
				if len(page.Runtimes) > 0 {
					@shared.SelectField(shared.SelectFieldProps{Label: msgDefaultAgentLabel.T(ctx), Name: "default_runtime", Value: page.DefaultRuntime, Placeholder: msgSystemAgentLabel.T(ctx), Options: editFormOptions(page.Runtimes)})
				}
				if page.OptionsError != "" {
					@shared.ErrorText(page.OptionsError)
				}
				if len(page.Options) > 0 {
					@shared.SelectField(shared.SelectFieldProps{Label: msgReplaceAgentsLabel.T(ctx), Name: "agents_file_id", Value: page.AgentsFileID, Placeholder: msgKeepCurrentLabel.T(ctx), Options: editFormOptions(page.Options)})
				}
				<div id="workspace-edit-result">
					if page.Error != "" {
						@shared.ErrorText(page.Error)
					}
				</div>
				<div class="row justify-end gap-2">
					@link.Tab(link.Props{Href: state.ListPath, Class: "btn-secondary"}) {
						{ msgCancelLabel.T(ctx) }
					}
					<button type="submit" class="btn-primary">{ msgSaveChangesLabel.T(ctx) }</button>
				</div>
			</form>
		</div>
	</div>
}

// EditSaved replaces the edit tab with the list once the workspace is saved.
templ EditSaved(listHref string) {
	<span data-dock-redirect={ listHref }></span>
}

// EditGroupsLazy is the group selector slot: it asks for the groups once the tab is shown and, meanwhile, shows
// "loading", so reading the groups never delays the page.
templ EditGroupsLazy(id string) {
	<div
		id="workspace-edit-groups"
		class="mb-4"
		hx-get={ "/workspaces/" + id + "/edit/groups" }
		hx-trigger="load"
		hx-target="this"
		hx-swap="outerHTML"
		aria-busy="true"
	>
		@shared.Loading(msgLoadingGroupsLabel.T(ctx))
	</div>
}

// EditGroups is the loaded group selector. It saves on its own when changed. Without groups the slot stays empty.
templ EditGroups(groups state.EditGroups) {
	if len(groups.Options) > 0 {
		<div id="workspace-edit-groups" class="card stack gap-2 mb-4 p-5 md:p-6" data-workspace-group-select>
			<span class="text-sm font-medium text-fg">{ msgGroupLabel.T(ctx) }</span>
			@shared.OptionSelect(shared.OptionSelectProps{
				Label:        msgGroupLabel.T(ctx),
				Value:        groups.Selected,
				DefaultLabel: msgNoGroupLabel.T(ctx),
				Options:      groupSelectOptions(groups.Options),
				Attrs: templ.Attributes{
					"name":       "group",
					"hx-post":    "/workspace-groups/workspaces/" + groups.ID + "/group",
					"hx-trigger": "change",
					"hx-swap":    "none",
				},
			})
		</div>
	} else {
		<div id="workspace-edit-groups"></div>
	}
}
