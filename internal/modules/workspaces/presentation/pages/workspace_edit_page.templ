package pages

import (
	shared "iworkflow/internal/core/components"
	"iworkflow/internal/core/dock/link"
	"iworkflow/internal/modules/workspaces/presentation/state"
)

// WorkspaceEditPage is the edit tab of one workspace. A successful save replaces the tab with the list.
templ WorkspaceEditPage(page state.EditPage) {
	<div class="h-full min-h-0 overflow-y-auto">
		<div class="mx-auto w-full max-w-3xl p-4 pb-10 md:p-6 md:pb-12">
			<form class="card stack gap-4 p-5 md:p-6" hx-post={ "/workspaces/" + page.ID + "/update" } hx-target="#workspace-edit-result" hx-swap="innerHTML">
				<h1 class="page-title">{ msgEditTitle.T(ctx) }</h1>
				@shared.TextField(shared.FieldProps{Label: msgNameLabel.T(ctx), Name: "name", Value: page.Name, Placeholder: msgNamePlaceholder.T(ctx), Required: true})
				<div class="stack gap-1.5">
					<span class="text-sm font-medium text-fg">{ msgPathLabel.T(ctx) }</span>
					<code class="truncate font-mono text-xs text-muted">{ page.Path }</code>
				</div>
				@shared.TextField(shared.FieldProps{Label: msgBaseBranchLabel.T(ctx), Name: "base_branch", Value: page.BaseBranch, Placeholder: "main"})
				if page.OptionsError != "" {
					@shared.ErrorText(page.OptionsError)
				}
				if len(page.Options) > 0 {
					@shared.SelectField(shared.SelectFieldProps{Label: msgReplaceAgentsLabel.T(ctx), Name: "agents_file_id", Value: page.AgentsFileID, Placeholder: msgKeepCurrentLabel.T(ctx), Options: editFormOptions(page.Options)})
				}
				<div id="workspace-edit-result">
					if page.Error != "" {
						@shared.ErrorText(page.Error)
					}
				</div>
				<div class="row justify-end gap-2">
					@link.Tab(link.Props{Href: "/workspaces", Class: "btn-secondary"}) {
						{ msgCancelLabel.T(ctx) }
					}
					<button type="submit" class="btn-primary">{ msgSaveChangesLabel.T(ctx) }</button>
				</div>
			</form>
		</div>
	</div>
}

// EditSaved replaces the edit tab with the list once the workspace is saved.
templ EditSaved() {
	<span data-dock-redirect="/workspaces"></span>
}
