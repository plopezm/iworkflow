package components

import (
	ui "iworkflow/internal/core/components"
	"iworkflow/internal/modules/task_hooks/presentation/state"
)

// Panel is the Hooks tab of a workspace. It replaces its own host, so every action answers it again with the
// refreshed hooks and the outcome of the action. Every value is escaped by templ, the output of a test included.
templ Panel(view state.View) {
	<section id={ state.HostID(view.WorkspaceID) } class="stack gap-4 p-4" data-workspace-hooks>
		<p class="muted text-sm">{ msgIntro.T(ctx) }</p>
		if view.Notice != state.NoticeNone {
			@ui.Badge(noticeText(ctx, view.Notice), "ok")
		}
		if view.Failure != "" {
			@ui.ErrorText(msgActionFailed.T(ctx) + " " + view.Failure)
		}
		if view.Editor != nil {
			@editor(view)
		}
		for _, section := range view.Sections {
			@eventSection(view, section)
		}
	</section>
}

templ eventSection(view state.View, section state.EventSection) {
	<section class="stack gap-2" data-hooks-event={ section.Event }>
		<h3 class="eyebrow">{ eventTitle(ctx, section.Event) }</h3>
		@phaseGroup(view, msgBefore.T(ctx), section.Before)
		@phaseGroup(view, msgAfter.T(ctx), section.After)
	</section>
}

templ phaseGroup(view state.View, label string, group state.PhaseGroup) {
	<div class="stack gap-2 rounded-xl border border-border/60 p-3" data-hooks-group={ group.Phase }>
		<div class="row justify-between gap-2">
			<span class="text-sm font-semibold">{ label }</span>
			<button
				type="button"
				class="btn-ghost"
				hx-get={ group.NewPath }
				hx-target={ "#" + state.HostID(view.WorkspaceID) }
				hx-swap="outerHTML"
			>{ msgAddHook.T(ctx) }</button>
		</div>
		if len(group.Rows) == 0 {
			<p class="muted text-sm">{ msgNoHooks.T(ctx) }</p>
		}
		for _, row := range group.Rows {
			@hookRow(view.WorkspaceID, row)
		}
	</div>
}

// hookRow is one hook. The move buttons submit the whole order of the workspace; a hook that cannot move that way
// has no order and its button is disabled.
templ hookRow(workspaceID string, row state.HookRow) {
	<div class="stack gap-1.5 border-t border-border/40 pt-2" data-hook={ row.ID }>
		<div class="row justify-between gap-2">
			<div class="stack gap-0.5 min-w-0">
				<span class="row gap-1.5">
					<span class="badge badge-muted">{ kindText(ctx, row.Kind) }</span>
					if row.Enabled {
						<span class="badge badge-ok">{ msgActive.T(ctx) }</span>
					} else {
						<span class="badge badge-warn">{ msgInactive.T(ctx) }</span>
					}
					<span class="text-[11px] text-muted">{ timeoutLabel(ctx, row.Timeout) } · { failureText(ctx, row.OnFailure) }</span>
				</span>
				<code class="text-[11px] text-muted break-all">{ row.Summary }</code>
			</div>
			<div class="row gap-1 shrink-0">
				<button
					type="button"
					class="btn-ghost"
					title={ msgMoveUp.T(ctx) }
					aria-label={ msgMoveUp.T(ctx) }
					disabled?={ row.UpOrder == "" }
					hx-post={ state.ReorderPath(workspaceID) }
					hx-vals={ orderVals(row.UpOrder) }
					hx-target={ "#" + state.HostID(workspaceID) }
					hx-swap="outerHTML"
				>↑</button>
				<button
					type="button"
					class="btn-ghost"
					title={ msgMoveDown.T(ctx) }
					aria-label={ msgMoveDown.T(ctx) }
					disabled?={ row.DownOrder == "" }
					hx-post={ state.ReorderPath(workspaceID) }
					hx-vals={ orderVals(row.DownOrder) }
					hx-target={ "#" + state.HostID(workspaceID) }
					hx-swap="outerHTML"
				>↓</button>
			</div>
		</div>
		<div class="row gap-2 flex-wrap">
			if row.Enabled {
				<button type="button" class="btn-ghost" hx-post={ state.EnabledPath(workspaceID, row.ID) } hx-vals={ enabledVals(false) } hx-target={ "#" + state.HostID(workspaceID) } hx-swap="outerHTML">{ msgDisable.T(ctx) }</button>
			} else {
				<button type="button" class="btn-ghost" hx-post={ state.EnabledPath(workspaceID, row.ID) } hx-vals={ enabledVals(true) } hx-target={ "#" + state.HostID(workspaceID) } hx-swap="outerHTML">{ msgEnable.T(ctx) }</button>
			}
			<button type="button" class="btn-secondary" hx-post={ state.TestPath(workspaceID, row.ID) } hx-target={ "#" + state.HostID(workspaceID) } hx-swap="outerHTML" hx-disabled-elt="this">{ msgTest.T(ctx) }</button>
			<button type="button" class="btn-ghost" hx-get={ state.EditPath(workspaceID, row.ID) } hx-target={ "#" + state.HostID(workspaceID) } hx-swap="outerHTML">{ msgEdit.T(ctx) }</button>
			<button type="button" class="btn-danger" hx-post={ state.DeletePath(workspaceID, row.ID) } hx-confirm={ msgConfirmDel.T(ctx) } hx-target={ "#" + state.HostID(workspaceID) } hx-swap="outerHTML">{ msgDelete.T(ctx) }</button>
		</div>
		if row.Test != nil {
			@testResult(row.Test)
		}
	</div>
}

templ testResult(result *state.TestResult) {
	<div class="stack gap-1 rounded-lg border border-border/60 p-2" data-hook-test={ result.Status }>
		<span class="text-xs font-semibold">{ resultLine(ctx, result) }</span>
		if result.Failure != "" {
			@ui.ErrorText(result.Failure)
		}
		<pre class="text-[11px] whitespace-pre-wrap break-all">{ outputText(ctx, result.Output) }</pre>
	</div>
}

// editor is the form of a new hook or of the one being edited. The kind selector reloads it, so the fields of the
// kind show; the form submits the whole editor to the save endpoint. The field names are the ones the DTO reads.
templ editor(view state.View) {
	<form
		id={ "workspace-hooks-form-" + view.WorkspaceID }
		class="stack gap-3 rounded-xl border border-border/60 p-3"
		hx-post={ state.SavePath(view.WorkspaceID) }
		hx-target={ "#" + state.HostID(view.WorkspaceID) }
		hx-swap="outerHTML"
		data-hook-editor
	>
		<span class="eyebrow">{ editorTitle(ctx, view.Editor.ID) }</span>
		if view.Editor.ID != "" {
			<input type="hidden" name="id" value={ view.Editor.ID }/>
		}
		@ui.SelectField(ui.SelectFieldProps{Label: msgEventLabel.T(ctx), Name: "event", Value: view.Editor.Event, Options: eventOptions(ctx)})
		@ui.SelectField(ui.SelectFieldProps{Label: msgPhaseLabel.T(ctx), Name: "phase", Value: view.Editor.Phase, Options: phaseOptions(ctx)})
		@kindSwitch(view)
		@ui.SelectField(ui.SelectFieldProps{Label: msgOnFailure.T(ctx), Name: "on_failure", Value: view.Editor.OnFailure, Options: failureOptions(ctx)})
		<label class="stack gap-1.5">
			<span class="text-sm font-medium text-fg">{ msgTimeout.T(ctx) } (s)</span>
			<input type="number" min="1" name="timeout" class="input" value={ view.Editor.Timeout } required/>
			<span class="text-[11px] text-muted">{ msgTimeoutHint.T(ctx) }</span>
		</label>
		<label class="row gap-2">
			<input type="checkbox" name="enabled" value="on" checked?={ view.Editor.Enabled }/>
			<span class="text-sm">{ msgEnabledLabel.T(ctx) }</span>
		</label>
		if view.Editor.Kind == kindAgent {
			@agentFields(view.Editor)
		} else {
			@scriptFields(view.Editor)
		}
		<div class="row gap-2">
			<button type="submit" class="btn-primary">{ msgSave.T(ctx) }</button>
			<button
				type="button"
				class="btn-ghost"
				hx-get={ state.PanelPath(view.WorkspaceID) }
				hx-target={ "#" + state.HostID(view.WorkspaceID) }
				hx-swap="outerHTML"
			>{ msgCancel.T(ctx) }</button>
		</div>
	</form>
}

// kindSwitch chooses the kind of the hook. Each button reloads the editor as the form was left, with the kind it
// names, so the fields of that kind show and what was typed stays. The hidden field is what the save submits.
templ kindSwitch(view state.View) {
	<div class="row gap-2" role="group" aria-label={ msgKindLabel.T(ctx) }>
		<input type="hidden" name="kind" value={ view.Editor.Kind }/>
		for _, option := range kindOptions(ctx) {
			<button
				type="button"
				class={ kindClass(option.Value == view.Editor.Kind) }
				aria-pressed={ pressedText(option.Value == view.Editor.Kind) }
				hx-get={ state.EditorPath(view.WorkspaceID, nil) }
				hx-vals={ kindVals(option.Value) }
				hx-include="closest form"
				hx-target={ "#" + state.HostID(view.WorkspaceID) }
				hx-swap="outerHTML"
			>{ option.Label }</button>
		}
	</div>
}

templ scriptFields(form *state.HookForm) {
	@ui.TextField(ui.FieldProps{Label: msgCommand.T(ctx), Name: "command", Value: form.Command, Placeholder: msgCommandHint.T(ctx)})
	@ui.TextArea(ui.FieldProps{Label: msgArgs.T(ctx), Name: "args", Value: form.Args})
	@ui.TextArea(ui.FieldProps{Label: msgEnv.T(ctx), Name: "env", Value: form.Env})
	<label class="row gap-2">
		<input type="checkbox" name="use_shell" value="on" checked?={ form.UseShell }/>
		<span class="text-sm">{ msgUseShell.T(ctx) }</span>
	</label>
}

templ agentFields(form *state.HookForm) {
	@ui.TextArea(ui.FieldProps{Label: msgPrompt.T(ctx), Name: "prompt", Value: form.Prompt, Large: true})
	@ui.TextField(ui.FieldProps{Label: msgRuntime.T(ctx), Name: "runtime", Value: form.Runtime})
	@ui.TextField(ui.FieldProps{Label: msgModel.T(ctx), Name: "model", Value: form.Model})
	@ui.TextField(ui.FieldProps{Label: msgThinking.T(ctx), Name: "thinking", Value: form.Thinking})
	@ui.TextField(ui.FieldProps{Label: msgProfile.T(ctx), Name: "profile", Value: form.Profile})
}
