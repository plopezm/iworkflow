package components

import (
	ui "iworkflow/internal/core/components"
	"iworkflow/internal/modules/task_hooks/presentation/state"
)

// Screen is the Hooks screen: the library with its editors, or the run history. It replaces its own host, so every
// action answers it again with the refreshed screen and the outcome of the action. Every value is escaped by templ,
// the output of a test and of a run included.
templ Screen(view state.Screen) {
	<section id={ state.HostID } class="stack h-full min-h-0 gap-4 overflow-y-auto p-4" data-hooks-screen>
		<div class="row justify-between gap-2 flex-wrap">
			<p class="muted text-sm">{ msgIntro.T(ctx) }</p>
			<div class="row gap-2">
				<button type="button" class={ tabClass(view.Tab == state.TabLibrary) } aria-pressed={ pressedText(view.Tab == state.TabLibrary) } hx-get={ state.LibraryPath() } hx-target={ hostTarget } hx-swap="outerHTML">{ msgTabLibrary.T(ctx) }</button>
				<button type="button" class={ tabClass(view.Tab == state.TabHistory) } aria-pressed={ pressedText(view.Tab == state.TabHistory) } hx-get={ state.HistoryPath("", "", true) } hx-target={ hostTarget } hx-swap="outerHTML">{ msgTabHistory.T(ctx) }</button>
			</div>
		</div>
		if view.Notice != state.NoticeNone {
			@ui.Badge(noticeText(ctx, view.Notice), "ok")
		}
		if view.Failure != "" {
			@ui.ErrorText(msgActionFailed.T(ctx) + " " + view.Failure)
		}
		if view.Tab == state.TabHistory && view.History != nil {
			@history(view.History)
		} else {
			@library(view)
		}
	</section>
}

// library is the list of hooks with the editor of one, the assignments of the selected hook and the run order panel.
templ library(view state.Screen) {
	<div class="stack gap-4" data-hooks-library>
		if view.Editor != nil {
			@editor(view)
		}
		<div class="stack gap-2">
			<div class="row justify-between gap-2">
				<span class="eyebrow">{ msgTitle.T(ctx) }</span>
				<button type="button" class="btn-primary" hx-get={ state.EditorPath() } hx-target={ hostTarget } hx-swap="outerHTML">{ msgNewHook.T(ctx) }</button>
			</div>
			if len(view.Hooks) == 0 {
				<p class="muted text-sm">{ msgNoHooks.T(ctx) }</p>
			}
			for _, row := range view.Hooks {
				@hookRow(row)
			}
		</div>
		if view.Selected != nil {
			@assignments(view.Selected, view.Projects)
		}
		if view.Group != nil {
			@group(view.Group, view.Projects)
		}
	</div>
}

// hookRow is one hook of the library: its kind, how many projects it is assigned to and its latest error.
templ hookRow(row state.HookRow) {
	<div class={ hookRowClass(row.Selected) } data-hook={ row.ID }>
		<div class="row justify-between gap-2 flex-wrap">
			<div class="stack gap-1 min-w-0">
				<span class="row gap-1.5 flex-wrap">
					<span class="text-sm font-semibold">{ row.Name }</span>
					<span class="badge badge-muted">{ kindText(ctx, row.Kind) }</span>
					<span class="text-[11px] text-muted">{ assignCountText(ctx, row.Assignments) }</span>
				</span>
				@lastError(row.LastError)
			</div>
			<div class="row gap-2 shrink-0">
				<button type="button" class="btn-ghost" hx-get={ state.HookPath(row.ID) } hx-target={ hostTarget } hx-swap="outerHTML">{ msgOpen.T(ctx) }</button>
				<button type="button" class="btn-ghost" hx-get={ state.EditorPath() } hx-vals={ hookVals(row.ID) } hx-target={ hostTarget } hx-swap="outerHTML">{ msgEdit.T(ctx) }</button>
				<button type="button" class="btn-danger" hx-post={ state.DeletePath(row.ID) } hx-confirm={ msgConfirmDel.T(ctx) } hx-target={ hostTarget } hx-swap="outerHTML">{ msgDelete.T(ctx) }</button>
			</div>
		</div>
	</div>
}

// lastError is the latest failed run of a hook. It opens the history filtered to that hook.
templ lastError(last *state.LastError) {
	if last == nil {
		<span class="text-[11px] text-muted">{ msgNoError.T(ctx) }</span>
	} else {
		<button type="button" class="badge badge-warn w-fit" hx-get={ last.HistoryPath } hx-target={ hostTarget } hx-swap="outerHTML">
			{ msgLastError.T(ctx) } · { resultText(ctx, last.Status) } · { last.StartedAt }
		</button>
	}
}

// editor is the form of a new hook or of the one being edited. The kind switch reloads it, so the fields of the kind
// show; the form submits the whole editor to the save endpoint. The field names are the ones the DTO reads.
templ editor(view state.Screen) {
	<form
		id="hooks-editor-form"
		class="stack gap-3 rounded-xl border border-border/60 p-3"
		hx-post={ state.SavePath() }
		hx-target={ hostTarget }
		hx-swap="outerHTML"
		data-hook-editor
	>
		<span class="eyebrow">{ editorTitle(ctx, view.Editor.ID) }</span>
		if view.Editor.ID != "" {
			<input type="hidden" name="id" value={ view.Editor.ID }/>
		}
		@ui.TextField(ui.FieldProps{Label: msgNameLabel.T(ctx), Name: "name", Value: view.Editor.Name, Placeholder: msgNameHint.T(ctx), Required: true})
		@kindSwitch(view)
		<label class="stack gap-1.5">
			<span class="text-sm font-medium text-fg">{ msgTimeout.T(ctx) } (s)</span>
			<input type="number" min="1" name="timeout" class="input" value={ view.Editor.Timeout } required/>
			<span class="text-[11px] text-muted">{ timeoutHint(ctx) }</span>
		</label>
		if view.Editor.Kind == kindAgent {
			@agentFields(view.Editor)
		} else {
			@scriptFields(view)
		}
		<div class="row gap-2">
			<button type="submit" class="btn-primary">{ msgSave.T(ctx) }</button>
			<button type="button" class="btn-ghost" hx-get={ state.LibraryPath() } hx-target={ hostTarget } hx-swap="outerHTML">{ msgCancel.T(ctx) }</button>
		</div>
	</form>
}

// kindSwitch chooses the kind of the hook. Each button reloads the editor as the form was left, with the kind it
// names, so the fields of that kind show and what was typed stays. The hidden field is what the save submits.
templ kindSwitch(view state.Screen) {
	<div class="row gap-2" role="group" aria-label={ msgKindLabel.T(ctx) }>
		<input type="hidden" name="kind" value={ view.Editor.Kind }/>
		for _, option := range kindOptions(ctx) {
			<button
				type="button"
				class={ kindClass(option.Value == view.Editor.Kind) }
				aria-pressed={ pressedText(option.Value == view.Editor.Kind) }
				hx-get={ state.EditorPath() }
				hx-vals={ kindVals(option.Value) }
				hx-include="closest form"
				hx-target={ hostTarget }
				hx-swap="outerHTML"
			>{ option.Label }</button>
		}
	</div>
}

templ scriptFields(view state.Screen) {
	@ui.SelectField(ui.SelectFieldProps{Label: msgBrowseFrom.T(ctx), Name: "browse_project", Value: view.Editor.BrowseProject, Options: choiceOptions(view.Projects)})
	@pathField(view, pathFieldProps{ID: "hook-command", Name: "command", Label: msgCommand.T(ctx), Value: view.Editor.Command, Placeholder: msgCommandHint.T(ctx), Hint: msgCommandNote.T(ctx)})
	<details class="stack gap-3" open?={ advancedOpen(view) }>
		<summary class="cursor-pointer text-sm font-medium text-fg">{ msgAdvanced.T(ctx) }</summary>
		<div class="stack gap-3 pt-3">
			@ui.TextArea(ui.FieldProps{Label: msgArgs.T(ctx), Name: "args", Value: view.Editor.Args})
			@ui.TextArea(ui.FieldProps{Label: msgEnv.T(ctx), Name: "env", Value: view.Editor.Env})
			@pathField(view, pathFieldProps{ID: "hook-working-dir", Name: "working_dir", Label: msgWorkingDir.T(ctx), Value: view.Editor.WorkingDir, Placeholder: msgWorkingDirHint.T(ctx), Hint: msgWorkingDirNote.T(ctx)})
		</div>
	</details>
}

// pathFieldProps describes a text field that can also be filled from the browser. Name is the form field and the
// field the browser fills.
type pathFieldProps struct {
	ID          string
	Name        string
	Label       string
	Value       string
	Placeholder string
	Hint        string
}

// pathField is a text field with a button that opens the browser under it. The user can type the path or pick it.
templ pathField(view state.Screen, props pathFieldProps) {
	<div class="stack gap-1.5">
		<label for={ props.ID } class="text-sm font-medium text-fg">{ props.Label }</label>
		<div class="row gap-2">
			<input id={ props.ID } type="text" name={ props.Name } class="input min-w-0 flex-1" value={ props.Value } placeholder={ props.Placeholder }/>
			<button
				type="button"
				class="btn-secondary shrink-0"
				hx-get={ state.EditorPath() }
				hx-vals={ browseVals(props.Name, "", "") }
				hx-include="closest form"
				hx-target={ hostTarget }
				hx-swap="outerHTML"
			>{ msgBrowse.T(ctx) }</button>
		</div>
		if props.Hint != "" {
			<span class="text-[11px] text-muted">{ props.Hint }</span>
		}
		if view.Browser != nil && view.Browser.Field == props.Name {
			@browser(view)
		}
	</div>
}

// browser lists one folder. A folder opens it, a file chooses it (only for the command), and a folder-only browser has
// a button to choose the folder being shown. Every button loads the editor again with the form as it was left.
templ browser(view state.Screen) {
	<div class="stack gap-2 rounded-lg border border-border/60 p-2" data-hook-browser={ view.Browser.Field }>
		<code class="text-[11px] text-muted break-all">{ view.Browser.Path }</code>
		<div class="row gap-2 flex-wrap">
			<button type="button" class="btn-ghost" disabled?={ view.Browser.Parent == "" } hx-get={ state.EditorPath() } hx-vals={ browseVals(view.Browser.Field, view.Browser.Parent, "") } hx-include="closest form" hx-target={ hostTarget } hx-swap="outerHTML">{ msgUp.T(ctx) }</button>
			if !view.Browser.Files {
				<button type="button" class="btn-primary" hx-get={ state.EditorPath() } hx-vals={ browseVals(view.Browser.Field, "", view.Browser.Path) } hx-include="closest form" hx-target={ hostTarget } hx-swap="outerHTML">{ msgUseFolder.T(ctx) }</button>
			}
			<button type="button" class="btn-ghost" hx-get={ state.EditorPath() } hx-vals={ closeVals() } hx-include="closest form" hx-target={ hostTarget } hx-swap="outerHTML">{ msgCloseBrowser.T(ctx) }</button>
		</div>
		if view.Browser.Error != "" {
			@ui.ErrorText(view.Browser.Error)
		}
		<ul class="stack max-h-60 gap-1 overflow-y-auto">
			if len(view.Browser.Entries) == 0 && view.Browser.Error == "" {
				<li class="muted px-2 py-1 text-sm">{ msgBrowserEmpty.T(ctx) }</li>
			}
			for _, entry := range view.Browser.Entries {
				<li>
					if entry.IsDir {
						<button type="button" class="btn-ghost row w-full justify-start gap-2 px-2 py-1" hx-get={ state.EditorPath() } hx-vals={ browseVals(view.Browser.Field, entry.Path, "") } hx-include="closest form" hx-target={ hostTarget } hx-swap="outerHTML">📁 { entry.Name }</button>
					} else {
						<button type="button" class="btn-ghost row w-full justify-start gap-2 px-2 py-1" hx-get={ state.EditorPath() } hx-vals={ browseVals(view.Browser.Field, "", entry.Path) } hx-include="closest form" hx-target={ hostTarget } hx-swap="outerHTML">📄 { entry.Name }</button>
					}
				</li>
			}
		</ul>
	</div>
}

templ agentFields(form *state.HookForm) {
	@ui.TextArea(ui.FieldProps{Label: msgPrompt.T(ctx), Name: "prompt", Value: form.Prompt, Large: true})
	@ui.TextField(ui.FieldProps{Label: msgRuntime.T(ctx), Name: "runtime", Value: form.Runtime})
	@ui.TextField(ui.FieldProps{Label: msgModel.T(ctx), Name: "model", Value: form.Model})
	@ui.TextField(ui.FieldProps{Label: msgThinking.T(ctx), Name: "thinking", Value: form.Thinking})
	@ui.TextField(ui.FieldProps{Label: msgProfile.T(ctx), Name: "profile", Value: form.Profile})
}

// assignments is the editor of the selected hook: its assignments, the form of a new one and the test of the hook.
templ assignments(detail *state.HookDetail, projects []state.Choice) {
	<section class="stack gap-3 rounded-xl border border-border/60 p-3" data-hook-assignments={ detail.HookID }>
		<span class="eyebrow">{ msgOpen.T(ctx) } · { detail.Name }</span>
		if len(detail.Assignments) == 0 {
			<p class="muted text-sm">{ msgNoAssignments.T(ctx) }</p>
		}
		for _, row := range detail.Assignments {
			@assignmentRow(detail.HookID, row)
		}
		@assignForm(detail, projects)
		@testForm(detail, projects)
		if detail.Result != nil {
			@testResult(detail.Result)
		}
	</section>
}

// assignmentRow is one project, event and moment the hook runs for. The toggle posts the stored values with the new
// enabled flag; the delete removes the assignment and keeps the hook in the library.
templ assignmentRow(hookID string, row state.AssignmentRow) {
	<div class="row justify-between gap-2 flex-wrap border-t border-border/40 pt-2" data-assignment={ row.Form.ID }>
		<div class="stack gap-0.5 min-w-0">
			<span class="row gap-1.5 flex-wrap">
				<span class="text-sm font-medium">{ row.ProjectName }</span>
				<span class="badge badge-muted">{ eventTitle(ctx, row.Form.Event) }</span>
				<span class="badge badge-muted">{ phaseText(ctx, row.Form.Phase) }</span>
				<span class={ "badge " + activeBadge(row.Form.Enabled) }>
					if row.Form.Enabled {
						{ msgActive.T(ctx) }
					} else {
						{ msgInactive.T(ctx) }
					}
				</span>
			</span>
			<span class="text-[11px] text-muted">{ msgPolicyLabel.T(ctx) }: { failureText(ctx, row.Form.OnFailure) }</span>
		</div>
		<div class="row gap-2 shrink-0">
			if row.Form.Enabled {
				<button type="button" class="btn-ghost" hx-post={ state.AssignmentPath(hookID, row.Form.ID) } hx-vals={ assignmentVals(row.Form, false) } hx-target={ hostTarget } hx-swap="outerHTML">{ msgDisable.T(ctx) }</button>
			} else {
				<button type="button" class="btn-ghost" hx-post={ state.AssignmentPath(hookID, row.Form.ID) } hx-vals={ assignmentVals(row.Form, true) } hx-target={ hostTarget } hx-swap="outerHTML">{ msgEnable.T(ctx) }</button>
			}
			<button type="button" class="btn-danger" hx-post={ state.AssignmentDeletePath(hookID, row.Form.ID) } hx-confirm={ msgConfirmDelAssign.T(ctx) } hx-target={ hostTarget } hx-swap="outerHTML">{ msgDelete.T(ctx) }</button>
		</div>
	</div>
}

// assignForm adds the hook to a project, event and moment. A repeated one is refused by the use case.
templ assignForm(detail *state.HookDetail, projects []state.Choice) {
	<form class="stack gap-2" hx-post={ state.AssignmentsPath(detail.HookID) } hx-target={ hostTarget } hx-swap="outerHTML" data-assignment-form>
		<span class="text-sm font-semibold">{ msgAddAssignment.T(ctx) }</span>
		@ui.SelectField(ui.SelectFieldProps{Label: msgProjectLabel.T(ctx), Name: "project", Value: detail.Add.Project, Placeholder: msgProjectChoose.T(ctx), Required: true, Options: choiceOptions(projects)})
		@ui.SelectField(ui.SelectFieldProps{Label: msgEventLabel.T(ctx), Name: "event", Value: detail.Add.Event, Options: eventOptions(ctx)})
		@ui.SelectField(ui.SelectFieldProps{Label: msgPhaseLabel.T(ctx), Name: "phase", Value: detail.Add.Phase, Options: phaseOptions(ctx)})
		@ui.SelectField(ui.SelectFieldProps{Label: msgOnFailure.T(ctx), Name: "on_failure", Value: detail.Add.OnFailure, Options: failureOptions(ctx)})
		<label class="row gap-2">
			<input type="checkbox" name="enabled" value="on" checked?={ detail.Add.Enabled }/>
			<span class="text-sm">{ msgEnabledLabel.T(ctx) }</span>
		</label>
		<div class="row">
			<button type="submit" class="btn-primary">{ msgAssignAdd.T(ctx) }</button>
		</div>
	</form>
}

// testForm runs the hook once, as if it were assigned to the chosen project, event and moment.
templ testForm(detail *state.HookDetail, projects []state.Choice) {
	<form class="stack gap-2" hx-post={ state.TestPath(detail.HookID) } hx-target={ hostTarget } hx-swap="outerHTML" hx-disabled-elt="find button" data-hook-test-form>
		<span class="text-sm font-semibold">{ msgRunTest.T(ctx) }</span>
		<span class="text-[11px] text-muted">{ msgTestHint.T(ctx) }</span>
		@ui.SelectField(ui.SelectFieldProps{Label: msgProjectLabel.T(ctx), Name: "project", Value: detail.Test.Project, Placeholder: msgProjectChoose.T(ctx), Required: true, Options: choiceOptions(projects)})
		@ui.SelectField(ui.SelectFieldProps{Label: msgEventLabel.T(ctx), Name: "event", Value: detail.Test.Event, Options: eventOptions(ctx)})
		@ui.SelectField(ui.SelectFieldProps{Label: msgPhaseLabel.T(ctx), Name: "phase", Value: detail.Test.Phase, Options: phaseOptions(ctx)})
		<div class="row">
			<button type="submit" class="btn-secondary">{ msgTest.T(ctx) }</button>
		</div>
	</form>
}

templ testResult(result *state.TestResult) {
	<div class="stack gap-1 rounded-lg border border-border/60 p-2" data-hook-test={ result.Status }>
		<span class="text-xs font-semibold">{ resultLine(ctx, result) }</span>
		if result.Failure != "" {
			@ui.ErrorText(result.Failure)
		}
		<pre class="text-[11px] whitespace-pre-wrap break-all">{ outputText(ctx, result.Output) }</pre>
	</div>
}

// group is the run order of one project, event and moment. The moves submit the whole order of the group.
templ group(group *state.Group, projects []state.Choice) {
	<section class="stack gap-2 rounded-xl border border-border/60 p-3" data-hooks-group>
		<span class="eyebrow">{ msgOrderTitle.T(ctx) }</span>
		<p class="muted text-[11px]">{ msgOrderHint.T(ctx) }</p>
		<form class="grid grid-cols-1 gap-3 sm:grid-cols-2 lg:grid-cols-[repeat(3,minmax(0,1fr))_auto] lg:items-end" hx-get={ state.GroupPath() } hx-target={ hostTarget } hx-swap="outerHTML">
			@ui.SelectField(ui.SelectFieldProps{Label: msgProjectLabel.T(ctx), Name: "project", Value: group.Project, Placeholder: msgProjectChoose.T(ctx), Options: choiceOptions(projects)})
			@ui.SelectField(ui.SelectFieldProps{Label: msgEventLabel.T(ctx), Name: "event", Value: group.Event, Options: eventOptions(ctx)})
			@ui.SelectField(ui.SelectFieldProps{Label: msgPhaseLabel.T(ctx), Name: "phase", Value: group.Phase, Options: phaseOptions(ctx)})
			<button type="submit" class="btn-secondary">{ msgShow.T(ctx) }</button>
		</form>
		if group.Project != "" && len(group.Rows) == 0 {
			<p class="muted text-sm">{ msgNoGroup.T(ctx) }</p>
		}
		for _, row := range group.Rows {
			@groupRow(*group, row)
		}
	</section>
}

templ groupRow(group state.Group, row state.GroupRow) {
	<div class="row justify-between gap-2 border-t border-border/40 pt-2" data-group-row={ row.ID }>
		<span class="row gap-1.5 min-w-0 flex-wrap">
			<span class="text-sm">{ row.HookName }</span>
			<span class={ "badge " + activeBadge(row.Enabled) }>
				if row.Enabled {
					{ msgActive.T(ctx) }
				} else {
					{ msgInactive.T(ctx) }
				}
			</span>
			<span class="text-[11px] text-muted">{ failureText(ctx, row.Policy) }</span>
		</span>
		<div class="row gap-1 shrink-0">
			<button type="button" class="btn-ghost" title={ msgMoveUp.T(ctx) } aria-label={ msgMoveUp.T(ctx) } disabled?={ row.UpOrder == "" } hx-post={ state.OrderPath() } hx-vals={ orderVals(group, row.UpOrder) } hx-target={ hostTarget } hx-swap="outerHTML">↑</button>
			<button type="button" class="btn-ghost" title={ msgMoveDown.T(ctx) } aria-label={ msgMoveDown.T(ctx) } disabled?={ row.DownOrder == "" } hx-post={ state.OrderPath() } hx-vals={ orderVals(group, row.DownOrder) } hx-target={ hostTarget } hx-swap="outerHTML">↓</button>
		</div>
	</div>
}

// history is the run history with its filters. A filter change reloads the list; the failed-only filter is on by
// default and the applied marker tells an unchecked box from a filter that was never sent.
templ history(h *state.History) {
	<div class="stack gap-3" data-hooks-history>
		<form class="row gap-2 flex-wrap items-end rounded-xl border border-border/60 p-3" hx-get={ state.HistoryRoute } hx-trigger="change" hx-target={ hostTarget } hx-swap="outerHTML" data-history-filter>
			<input type="hidden" name="applied" value="1"/>
			@ui.SelectField(ui.SelectFieldProps{Label: msgHook.T(ctx), Name: "hook", Value: h.HookID, Placeholder: msgAllHooks.T(ctx), Options: choiceOptions(h.Hooks)})
			@ui.SelectField(ui.SelectFieldProps{Label: msgProjectLabel.T(ctx), Name: "project", Value: h.ProjectID, Placeholder: msgAllProjects.T(ctx), Options: choiceOptions(h.Projects)})
			<label class="row gap-2">
				<input type="checkbox" name="failed" value="1" checked?={ h.Failed }/>
				<span class="text-sm">{ msgFailedOnly.T(ctx) }</span>
			</label>
		</form>
		if len(h.Runs) == 0 {
			<p class="muted text-sm">{ msgNoRuns.T(ctx) }</p>
		}
		for _, run := range h.Runs {
			@runRow(run)
		}
	</div>
}

// runRow is one run of the history: its status, exit code, task, project, hook and time, and its output, folded.
templ runRow(run state.RunRow) {
	<div class="stack gap-1 rounded-lg border border-border/60 p-2" data-run={ run.ID } data-run-status={ run.Status }>
		<div class="row justify-between gap-2 flex-wrap">
			<span class="row gap-1.5 flex-wrap">
				<span class={ "badge " + runStatusClass(run.Status) }>{ resultText(ctx, run.Status) }</span>
				if run.HasExitCode {
					<span class="text-[11px] text-muted">{ exitText(ctx, run.ExitCode) }</span>
				}
				<span class="text-sm font-medium">{ run.HookName }</span>
			</span>
			<span class="text-[11px] text-muted">{ run.ProjectName } · { msgTask.T(ctx) } { run.TaskID } · { run.StartedAt }</span>
		</div>
		<details>
			<summary class="text-[11px] cursor-pointer">{ msgShowOutput.T(ctx) }</summary>
			<pre class="text-[11px] whitespace-pre-wrap break-all">{ outputText(ctx, run.Output) }</pre>
		</details>
	</div>
}
