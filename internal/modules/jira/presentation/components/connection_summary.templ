package components

import (
	ui "iworkflow/internal/core/components"
	"iworkflow/internal/modules/jira/presentation/state"
)

// JiraConnectionSummary renders the stored connection details and edit/disconnect actions.
templ JiraConnectionSummary(view state.ConnectionCardView) {
	if view.Stored != nil {
		<div class="stack gap-2">
			<p class="text-sm">
				<span class="muted">{ msgServer.T(ctx) }</span>
				<strong>{ view.Stored.BaseURL }</strong>
			</p>
			<p class="text-sm">
				<span class="muted">{ msgLastSync.T(ctx) }</span>
				if view.LastSyncAtFormatted() != "" {
					{ view.LastSyncAtFormatted() }
				} else {
					{ msgNever.T(ctx) }
				}
			</p>
			if view.Stored.LastSyncError != nil && *view.Stored.LastSyncError != "" {
				@ui.ErrorText(msgLastFailure.Fmt(ctx, map[string]string{"error": *view.Stored.LastSyncError}))
			}
			if view.Err != "" {
				@ui.ErrorText(view.Err)
			}
			<div class="row flex-wrap gap-2">
				<button
					type="button"
					class="btn-secondary"
					hx-get="/jira/connection/edit"
					hx-target="#jira-connection-card"
					hx-swap="outerHTML"
				>
					{ msgEdit.T(ctx) }
				</button>
				if view.ConfirmingDelete {
					<span class="row items-center gap-2 text-sm">
						<span>{ msgForgetNotice.T(ctx) }</span>
						<button
							type="button"
							class="btn-danger"
							hx-post="/jira/connection/disconnect"
							hx-target="#jira-connection-card"
							hx-swap="outerHTML"
						>
							{ msgDisconnect.T(ctx) }
						</button>
						<button
							type="button"
							class="btn-ghost"
							hx-get="/jira/connection/cancel"
							hx-target="#jira-connection-card"
							hx-swap="outerHTML"
						>
							{ msgCancel.T(ctx) }
						</button>
					</span>
				} else {
					<button
						type="button"
						class="btn-ghost"
						hx-get="/jira/connection?confirm_delete=1"
						hx-target="#jira-connection-card"
						hx-swap="outerHTML"
					>
						{ msgDisconnect.T(ctx) }
					</button>
				}
			</div>
		</div>
	}
}
