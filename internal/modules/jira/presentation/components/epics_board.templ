package components

import (
	"context"
	"strconv"

	shared "iworkflow/internal/core/components"
	"iworkflow/internal/core/dock/link"
	"iworkflow/internal/modules/jira/infrastructure/adapters/inbound/dto"
	"iworkflow/internal/modules/jira/presentation/state"
)

// epicFilterInclude selects the filter fields that every epic-board request sends along, so the view keeps
// the search and the status filters while the user moves between epics.
const epicFilterInclude = "#jira-filters [name=search],#jira-filters [name=status],#jira-filters [name=local_state]"

// EpicsBoard renders the Epic master-detail view: the epic list on the left and the open epic's issues on
// the right. It stacks on small screens.
templ EpicsBoard(view state.IssuesPanelView) {
	if view.Total == 0 {
		@epicsEmptyCard(msgEpicsEmptyTitle.T(ctx), msgEpicsEmptyHint.T(ctx))
	} else if len(view.Epics) == 0 {
		@epicsEmptyCard(msgNoEpicsMatch.T(ctx), "")
	} else {
		<div class="grid gap-4 lg:grid-cols-[minmax(18rem,24rem)_minmax(0,1fr)] lg:items-start">
			<ul class="flex min-w-0 flex-col gap-2" aria-label={ msgModeEpics.T(ctx) }>
				for _, group := range view.Epics {
					<li>
						@epicCard(view, group)
					</li>
				}
			</ul>
			@epicDetail(view)
		</div>
	}
}

templ epicsEmptyCard(title string, hint string) {
	<div class="card flex flex-col items-center gap-1.5 py-8 text-center">
		<p class="text-sm font-semibold text-fg">{ title }</p>
		if hint != "" {
			<p class="muted">{ hint }</p>
		}
	</div>
}

// epicCard is one epic in the list: its key, title, progress, and the status counts of its children. The
// whole card is the click target that opens the epic.
templ epicCard(view state.IssuesPanelView, group dto.EpicGroupDTO) {
	{{
		selected := group.Key == view.SelectedEpic
		noEpic := state.IsNoEpic(group)
		done := strconv.Itoa(group.Done)
		total := strconv.Itoa(len(group.Children))
	}}
	<button
		type="button"
		class={ epicCardClass(selected, noEpic) }
		aria-current={ strconv.FormatBool(selected) }
		hx-get={ epicBoardURL(group.Key) }
		hx-include={ epicFilterInclude }
		hx-target="#jira-board"
		hx-swap="outerHTML"
	>
		<span class="flex min-w-0 items-center justify-between gap-2">
			if !noEpic {
				<span class="min-w-0 truncate font-mono text-[11px] text-muted">{ group.Key }</span>
			}
			if group.Epic != nil {
				@shared.Badge(group.Epic.Status, state.StatusVariant(group.Epic.Status))
			}
		</span>
		<span class="line-clamp-2 text-sm font-semibold leading-snug text-fg">{ groupTitle(ctx, group) }</span>
		<span class="flex items-center gap-2">
			<span
				role="progressbar"
				aria-label={ progressText(ctx, group) }
				aria-valuemin="0"
				aria-valuemax={ total }
				aria-valuenow={ done }
				class="flex h-1.5 min-w-0 flex-1 overflow-hidden rounded-full bg-surface-3"
			>
				<span class="h-full bg-stage-done motion-safe:transition-[width] duration-200" style={ progressStyle(state.ProgressPercent(group)) }></span>
			</span>
			<span class="shrink-0 font-mono text-[11px] tabular-nums text-muted">{ done }/{ total }</span>
		</span>
		if len(group.Counts) > 0 {
			<span class="flex flex-wrap gap-1">
				for _, count := range group.Counts {
					<span class={ "badge badge-" + state.StatusVariant(count.Status) }>
						{ count.Status }
						<span class="tabular-nums opacity-70">{ strconv.Itoa(count.Count) }</span>
					</span>
				}
			</span>
		}
	</button>
}

// epicDetail shows the open epic. When no epic is open, or the open one is filtered out, it shows a hint.
templ epicDetail(view state.IssuesPanelView) {
	{{ group := view.SelectedGroup() }}
	if group == nil {
		<section class="flex min-h-40 flex-col items-center justify-center rounded-lg border border-dashed border-border p-6 text-center">
			<p class="muted">{ msgSelectEpic.T(ctx) }</p>
		</section>
	} else {
		@epicDetailBody(*group)
	}
}

templ epicDetailBody(group dto.EpicGroupDTO) {
	{{
		total := len(group.Children)
		totalText := strconv.Itoa(total)
	}}
	<section
		class="flex min-w-0 flex-col gap-4 rounded-lg border border-border bg-surface p-4"
		aria-label={ groupTitle(ctx, group) }
	>
		<header class="flex min-w-0 flex-col gap-2">
			<div class="flex flex-wrap items-center gap-2">
				if group.Epic != nil {
					@link.Tab(link.Props{
						Href:  "/jira/" + group.Key,
						Class: "font-mono text-xs font-semibold text-accent",
					}) {
						{ group.Key }
					}
					@shared.Badge(group.Epic.Status, state.StatusVariant(group.Epic.Status))
				} else if !state.IsNoEpic(group) {
					<span class="font-mono text-xs text-muted">{ group.Key }</span>
				}
				if group.Epic != nil && group.Epic.URL != "" {
					<a
						href={ templ.SafeURL(group.Epic.URL) }
						target="_blank"
						rel="noreferrer noopener"
						class="btn-ghost ml-auto min-h-8 px-3 py-1 text-xs"
					>
						{ msgOpenInJira.T(ctx) }
					</a>
				}
			</div>
			<h2 class="break-words text-base leading-snug font-semibold text-fg">{ groupTitle(ctx, group) }</h2>
			if state.IsNoEpic(group) {
				<p class="muted">{ msgNoEpicHint.T(ctx) }</p>
			}
			<div class="flex items-center gap-3">
				<span
					role="progressbar"
					aria-label={ progressText(ctx, group) }
					aria-valuemin="0"
					aria-valuemax={ totalText }
					aria-valuenow={ strconv.Itoa(group.Done) }
					class="flex h-2 min-w-0 flex-1 overflow-hidden rounded-full bg-surface-3"
				>
					<span class="h-full bg-stage-done motion-safe:transition-[width] duration-200" style={ progressStyle(state.ProgressPercent(group)) }></span>
				</span>
				<span class="shrink-0 text-xs tabular-nums text-muted">{ progressText(ctx, group) }</span>
			</div>
		</header>
		<div class="flex flex-col gap-2">
			<h3 class="eyebrow">{ msgChildIssues.T(ctx) } · { totalText }</h3>
			if total == 0 {
				<p class="muted py-4">{ msgEpicNoChildren.T(ctx) }</p>
			} else {
				<ul class="flex flex-col divide-y divide-border">
					for _, child := range group.Children {
						@epicChildRow(group.Key, child)
					}
				</ul>
			}
		</div>
	</section>
}

// epicChildRow is one issue of the open epic. Its status control sits on the right; the secondary actions
// sit under the metadata.
templ epicChildRow(epicKey string, child dto.IssueDTO) {
	<li class="flex flex-col gap-2 py-3 sm:flex-row sm:items-start sm:gap-4">
		<div class="flex min-w-0 flex-1 flex-col gap-1.5">
			<div class="flex min-w-0 flex-wrap items-baseline gap-x-2 gap-y-0.5">
				@link.Tab(link.Props{
					Href:  "/jira/" + child.Key,
					Class: "shrink-0 font-mono text-xs font-semibold text-accent",
				}) {
					{ child.Key }
				}
				<span class="min-w-0 break-words text-sm font-medium text-fg">{ child.Summary }</span>
			</div>
			<div class="flex flex-wrap items-center gap-x-3 gap-y-1 text-xs text-muted">
				<span>{ child.IssueType }</span>
				if child.Priority != nil && *child.Priority != "" {
					<span>{ *child.Priority }</span>
				}
				if child.Assignee != nil && *child.Assignee != "" {
					<span>→ { *child.Assignee }</span>
				}
				<span>{ state.ShortTimestamp(child.JiraUpdatedAt) }</span>
			</div>
			@IssueActions(child, true)
		</div>
		@epicStatusControl(epicKey, child)
	</li>
}

// epicStatusControl is the status of one child, styled as a badge with a chevron. Pressing it asks the
// server for the allowed transitions and swaps this element for the menu (EpicStatusMenu).
templ epicStatusControl(epicKey string, child dto.IssueDTO) {
	<div id={ "status-" + child.Key } class="relative shrink-0">
		<button
			type="button"
			class={ statusTriggerClass(child.Status) }
			title={ msgChangeStatus.T(ctx) }
			aria-haspopup="true"
			hx-get={ epicTransitionsURL(epicKey, child.Key) }
			hx-target={ "#status-" + child.Key }
			hx-swap="outerHTML"
			hx-indicator={ "#status-spin-" + child.Key }
			hx-disabled-elt="this"
		>
			{ child.Status }
			<span id={ "status-spin-" + child.Key } class="htmx-indicator spinner" aria-hidden="true"></span>
			<span aria-hidden="true" class="opacity-70">▾</span>
		</button>
	</div>
}

// epicCardClass styles an epic card: an accent border and tint when it is open, a dashed border for the
// group without epic.
func epicCardClass(selected bool, noEpic bool) string {
	const base = "flex min-h-11 w-full min-w-0 cursor-pointer flex-col gap-2.5 rounded-lg border p-3 text-left motion-safe:transition-colors duration-150 "
	switch {
	case selected:
		return base + "border-accent bg-accent/10"
	case noEpic:
		return base + "border-dashed border-border bg-transparent hover:border-accent/50 hover:bg-surface"
	default:
		return base + "border-border bg-surface hover:border-accent/50 hover:bg-surface-2"
	}
}

// statusBadgeClass is the badge of a Jira status, with the 32px height of the controls around it.
func statusBadgeClass(status string) string {
	return "badge badge-" + state.StatusVariant(status) + " min-h-8"
}

// statusTriggerClass is the status badge drawn as a button.
func statusTriggerClass(status string) string {
	return statusBadgeClass(status) + " cursor-pointer motion-safe:transition-[filter] duration-150 hover:brightness-110 focus-visible:brightness-110 disabled:cursor-wait disabled:opacity-70"
}

// progressStyle is the width of the done share of a progress bar.
func progressStyle(percent int) string {
	return "width: " + strconv.Itoa(percent) + "%"
}

// progressText is the "done of total" summary of a group.
func progressText(ctx context.Context, group dto.EpicGroupDTO) string {
	return msgProgress.Fmt(ctx, map[string]string{
		"done":  strconv.Itoa(group.Done),
		"total": strconv.Itoa(len(group.Children)),
	})
}

// groupTitle is the heading of a group: the epic title, or the localized "No epic" for the group without one.
func groupTitle(ctx context.Context, group dto.EpicGroupDTO) string {
	if state.IsNoEpic(group) {
		return msgNoEpic.T(ctx)
	}
	return state.EpicTitle(group)
}

func epicBoardURL(epic string) string {
	return "/jira/board?mode=epics&epic=" + epic
}

func epicTransitionsURL(epic string, issue string) string {
	return "/jira/epics/" + epic + "/issues/" + issue + "/transitions"
}

func epicTransitionURL(epic string, issue string) string {
	return "/jira/epics/" + epic + "/issues/" + issue + "/transition"
}
