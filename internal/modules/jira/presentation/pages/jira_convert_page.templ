package pages

import (
	"fmt"

	shared "iworkflow/internal/core/components"
	"iworkflow/internal/core/dock/link"
	"iworkflow/internal/core/i18n"
	"iworkflow/internal/modules/jira/infrastructure/adapters/inbound/dto"
	"iworkflow/internal/modules/jira/presentation/state"
)

// ConversionBranchContainer renders the branch selector for the conversion form.
templ ConversionBranchContainer(branches []dto.ConversionBranchDTO) {
	<div id="conversion-branch-container" class="stack gap-1.5">
		<label class="stack gap-1.5">
			<span class="text-sm font-medium text-fg">{ msgBaseBranchLabel.T(ctx) }</span>
			<select class="input" name="base_branch" aria-label={ msgBaseBranchLabel.T(ctx) }>
				<option value="">{ msgDefaultBranchHint.T(ctx) }</option>
				for _, b := range branches {
					<option value={ b.Name }>{ formatBranchOption(ctx, b) }</option>
				}
			</select>
		</label>
	</div>
}

// JiraConvertPage renders the issue conversion screen.
templ JiraConvertPage(view state.ConvertIssueView) {
	<div id="jira-convert-container" class="h-full min-h-0 overflow-y-auto">
		<div class="mx-auto stack w-full max-w-3xl gap-4 p-4 pb-10 md:p-6 md:pb-12">
			<div class="row items-center justify-between gap-2">
				<h1 class="page-title">{ FormatConvertHeading(ctx, view.Preparation.Issue.Key) }</h1>
				<a href={ templ.SafeURL(fmt.Sprintf("/jira/%s", view.Preparation.Issue.Key)) } class="btn-ghost">
					{ msgViewJiraIssue.T(ctx) }
				</a>
			</div>
			<p class="muted text-sm">{ msgReviewHint.T(ctx) }</p>

			if view.Error != "" {
				@shared.ErrorText(view.Error)
			}

			if view.Converted != nil {
				if view.Converted.StartError == nil || *view.Converted.StartError == "" {
					<p class="sr-only" data-dock-leave="/"></p>
				} else {
					@shared.Card(msgTaskCreated.T(ctx)) {
						@shared.ErrorText(*view.Converted.StartError)
						<div class="row flex-wrap gap-2 pt-2">
							@link.Tab(link.Props{Href: "/", Class: "btn-primary", Role: "button", Reuse: "board"}) {
								{ msgBoardButton.T(ctx) }
							}
							<a href={ templ.SafeURL(fmt.Sprintf("/jira/%s", view.Preparation.Issue.Key)) } class="btn-ghost">
								{ msgViewJiraIssue.T(ctx) }
							</a>
						</div>
					}
				}
			} else {
				@shared.Card("") {
					<form
						class="stack gap-4"
						method="post"
						action={ templ.SafeURL(fmt.Sprintf("/jira/%s/convert", view.Preparation.Issue.Key)) }
						hx-post={ fmt.Sprintf("/jira/%s/convert", view.Preparation.Issue.Key) }
						hx-target="#jira-convert-container"
						hx-swap="outerHTML"
					>
						if len(view.Preparation.Workspaces) == 0 {
							<p class="text-sm muted">
								{ msgNoWorkspacePrefix.T(ctx) }
								<a href="/workspaces" class="link">{ msgNoWorkspaceLink.T(ctx) }</a>
								{ msgNoWorkspaceSuffix.T(ctx) }
							</p>
						} else {
							<label class="stack gap-1.5">
								<span class="text-sm font-medium text-fg">{ msgWorkspaceLabel.T(ctx) }</span>
								<select
									class="input"
									name="workspace_id"
									aria-label={ msgWorkspaceLabel.T(ctx) }
									required
									hx-get={ fmt.Sprintf("/jira/%s/convert/branches", view.Preparation.Issue.Key) }
									hx-target="#conversion-branch-container"
									hx-swap="outerHTML"
								>
									if len(view.Preparation.Workspaces) > 1 {
										<option value="">{ msgPickWorkspace.T(ctx) }</option>
									}
									for _, ws := range view.Preparation.Workspaces {
										<option
											value={ ws.ID }
											selected?={ len(view.Preparation.Workspaces) == 1 }
										>
											{ fmt.Sprintf("%s (%s)", ws.Name, ws.BaseBranch) }
										</option>
									}
								</select>
							</label>
						}

						@ConversionBranchContainer(view.Branches)

						<label class="stack gap-1.5">
							<span class="text-sm font-medium text-fg">{ msgTitleLabel.T(ctx) }</span>
							<input
								type="text"
								class="input"
								name="title"
								aria-label={ msgTitleLabel.T(ctx) }
								value={ view.Preparation.Title }
								required
							/>
						</label>

						@relatedProjectsField(view)

						<div
							class="stack gap-1.5 composer"
							data-composer
							data-files-path="/board/tasks/composer/files"
							data-remove-label={ msgRemoveReference.T(ctx) }
						>
							<label class="text-sm font-medium text-fg" for="jira-convert-prompt">{ msgPromptLabel.T(ctx) }</label>
							<div class="composer-field composer-field-task relative" data-composer-field>
								<ul class="composer-menu" role="listbox" aria-label={ msgSuggestions.T(ctx) } data-composer-menu hidden></ul>
								<textarea
									id="jira-convert-prompt"
									class="input input-lg min-h-32 resize-y"
									name="prompt"
									required
									data-composer-input
								>{ view.Preparation.Prompt }</textarea>
								<span class="composer-grip" data-composer-grip aria-hidden="true"></span>
							</div>
							<ul class="composer-refs flex flex-wrap gap-1" data-composer-refs hidden></ul>
						</div>

						<label class="stack gap-1.5">
							<span class="text-sm font-medium text-fg">{ msgPriorityLabel.T(ctx) }</span>
							<select class="input" name="priority" aria-label={ msgPriorityLabel.T(ctx) }>
								for _, opt := range state.PriorityOptions() {
									<option
										value={ opt.Value }
										selected?={ opt.Value == view.Preparation.Priority || (view.Preparation.Priority == "" && opt.Value == "normal") }
									>
										{ opt.LabelText(i18n.StateFrom(ctx).Locale) }
									</option>
								}
							</select>
						</label>

						<label class="row items-center gap-2">
							<input type="checkbox" name="start_now" value="true" class="checkbox" />
							<span class="text-sm">{ msgStartNowLabel.T(ctx) }</span>
						</label>

						<div class="row justify-end">
							<button type="submit" class="btn-primary" disabled?={ len(view.Preparation.Workspaces) == 0 }>
								{ msgCreateTaskButton.T(ctx) }
							</button>
						</div>
					</form>
				}
			}
		</div>
	</div>
}

// relatedProjectsField lets the user choose other workspaces the task may read and complete with @. Its markup carries
// the data attributes web/static/js/task_form.js and composer.js act on, as the task forms do.
templ relatedProjectsField(view state.ConvertIssueView) {
	if len(view.Preparation.Workspaces) > 1 {
		<div class="stack gap-2" data-related-projects>
			<span class="text-sm font-medium text-fg">{ msgRelatedProjects.T(ctx) }</span>
			<p class="text-xs text-muted">{ msgRelatedProjectsHint.T(ctx) }</p>
			<div class="row flex-wrap items-center gap-2">
				<button type="button" class="btn-secondary self-start" data-related-open>
					<span>{ msgChooseProjects.T(ctx) }</span>
					<span class="text-xs text-muted" data-related-count></span>
				</button>
				<ul class="flex flex-wrap gap-1" data-related-summary></ul>
			</div>
			@shared.Modal(shared.ModalProps{Title: msgRelatedProjects.T(ctx), Open: false}) {
				<input type="search" class="input" placeholder={ msgFilterProjects.T(ctx) } aria-label={ msgFilterProjects.T(ctx) } autocomplete="off" data-related-filter/>
				<div class="stack max-h-[50vh] overflow-y-auto" data-related-list>
					for _, ws := range view.Preparation.Workspaces {
						<label class="row min-h-10 items-center gap-2 text-sm text-fg" data-related-row data-related-name={ ws.Name } data-related-text={ ws.Name + " " + ws.Path }>
							<input type="checkbox" name="related_project_id" value={ ws.ID } data-workspace-id={ ws.ID } class="h-5 w-5" checked?={ view.IsRelated(ws.ID) }/>
							<span class="stack gap-0.5">
								<span>{ ws.Name }</span>
								<span class="text-xs text-muted">{ ws.Path }</span>
							</span>
						</label>
					}
					<p class="text-sm text-muted" data-related-empty hidden>{ msgNoProjects.T(ctx) }</p>
				</div>
				<div class="row justify-end">
					<button type="button" class="btn-primary" data-modal-close>{ msgDone.T(ctx) }</button>
				</div>
			}
		</div>
	}
}
