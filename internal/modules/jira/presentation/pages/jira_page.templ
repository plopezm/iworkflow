package pages

import (
	"iworkflow/internal/modules/jira/presentation/components"
	"iworkflow/internal/modules/jira/presentation/state"
)

// JiraPage renders the Jira screen hosting the connection card.
templ JiraPage(view state.ConnectionCardView) {
	<div class="flex h-full min-h-0 flex-col">
		<div class="flex shrink-0 items-center border-b border-border bg-surface px-4 py-2.5">
			<h1 class="page-title">Jira</h1>
		</div>
		<div class="stack min-h-0 flex-1 overflow-y-auto p-4">
			@components.JiraConnectionCard(view)
		</div>
	</div>
}
