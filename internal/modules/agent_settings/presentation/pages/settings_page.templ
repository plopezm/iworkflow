package pages

import ui "iworkflow/internal/core/components"

// SettingsPage is the settings screen: a switch with one segment per section, and the section
// bodies. Segments load the page of another section through the dock, which swaps this root.
templ SettingsPage(p SettingsPageProps) {
	<div id={ SettingsPageID } class="flex h-full min-h-0 flex-col">
		<div class="flex shrink-0 flex-wrap items-center justify-between gap-2 border-b border-border bg-surface px-4 py-2.5">
			<h1 class="page-title">{ p.Title }</h1>
			@ui.SegmentedControl(ui.SegmentedControlProps{
				Options:   sectionSegments(p),
				Selected:  p.Active,
				AriaLabel: p.SectionsName,
			})
		</div>
		<div class="stack min-h-0 flex-1 overflow-y-auto p-4">
			for _, section := range p.Sections {
				@ui.KeepAlive(ui.KeepAliveProps{Active: section.ID == p.Active}) {
					@section.Content
				}
			}
		</div>
	</div>
}
