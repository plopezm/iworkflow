package pages

import (
	coreui "iworkflow/internal/core/components"
	"iworkflow/internal/modules/agents_files/presentation/components"
	"iworkflow/internal/modules/agents_files/presentation/state"
)

// AgentsFilesPage is the body of the AGENTS.md tab: the upload card above the list of stored files.
templ AgentsFilesPage(page state.Page) {
	<div class="flex h-full min-h-0 flex-col">
		<div class="flex shrink-0 items-center border-b border-border bg-surface px-4 py-2.5">
			<h1 class="page-title">AGENTS.md</h1>
		</div>
		<div class="stack min-h-0 flex-1 overflow-y-auto p-4">
			@components.UploadSection(page.Upload)
			@coreui.Card(msgFiles.T(ctx)) {
				@components.FileList(page.Files)
			}
		</div>
	</div>
}
