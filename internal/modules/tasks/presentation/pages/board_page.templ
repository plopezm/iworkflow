package pages

import (
	"iworkflow/internal/modules/tasks/presentation/components"
	"iworkflow/internal/modules/tasks/presentation/state"
)

// BoardPage is the board tab: the toolbar, the list of the workspace and the notice. The list refreshes on the task stream, which the shell connects once for
// the whole page (see the sidebar), so the board does not open a second stream. The notice and the slot carry the
// scope of this board instance, so several open boards keep their own.
templ BoardPage(view state.BoardView) {
	<div class="flex h-full min-h-0 flex-col">
		@components.BoardToolbar(view)
		<div id={ state.Scoped("board-notice", view.Scope) }></div>
		<div class="board-body min-h-0 flex-1 overflow-hidden">
			@components.BoardList(view)
		</div>
	</div>
}

// DashboardPage is the global dashboard tab: every project with its running and pending tasks, and the global graph.
templ DashboardPage(view state.DashboardView) {
	<div class="flex h-full min-h-0 flex-col">
		<div id={ state.Scoped("board-notice", view.Scope) }></div>
		@components.Dashboard(view)
	</div>
}
