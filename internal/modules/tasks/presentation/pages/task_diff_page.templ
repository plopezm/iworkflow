package pages

import (
	"iworkflow/internal/modules/tasks/presentation/components"
	"iworkflow/internal/modules/tasks/presentation/state"
)

// TaskDiffPage is the diff tab of a task: the whole width of its group, scrolled as one.
templ TaskDiffPage(view state.DiffView) {
	<div class="h-full min-h-0 overflow-y-auto p-3">
		@components.DiffView(view)
	</div>
}
