package components

import "iworkflow/internal/modules/tasks/presentation/state"

// DiffFileCard is one changed file: its header (status, path and counters) and its body in the layout of the view.
// The header is the toggle of the card, a native details element, so the card opens and closes without a request.
// A file that can be edited offers its editor under the header; the editor loads into the slot of the card. The slot is
// hx-preserve: when the view reloads after a save, an editor that is open keeps its text.
templ DiffFileCard(file state.FileDiff, view state.DiffView, open bool) {
	<details id={ state.CardID(view.Scope, file.Path) } class="diff-card" open?={ open }>
		<summary class="diff-card-header diff-card-toggle">
			@DiffStatusBadge(file.Status)
			<span class="min-w-0 flex-1 truncate font-mono text-xs" title={ fileTitle(file) }>{ fileTitle(file) }</span>
			@DiffCounts(file.Additions, file.Deletions)
		</summary>
		if state.CanEditFile(file, view.CanEdit) {
			<div class="diff-card-actions flex justify-end p-2">
				<button type="button" class="btn-secondary" hx-get={ state.FileEditorPath(view.TaskID, view.Scope, file.Path) } hx-target={ "#" + state.FileSlotID(view.Scope, file.Path) } hx-swap="innerHTML">{ msgEdit.T(ctx) }</button>
			</div>
			<div id={ state.FileSlotID(view.Scope, file.Path) } hx-preserve="true"></div>
		}
		if file.Binary {
			<p class="muted p-3">{ msgBinaryFile.T(ctx) }</p>
		} else if len(file.Hunks) == 0 {
			<p class="muted p-3">{ msgNoContentChanges.T(ctx) }</p>
		} else if view.Layout.Mode == state.ViewUnified {
			@unifiedBody(file.Path, file.Hunks)
		} else {
			@splitBody(file.Path, file.Hunks)
		}
	</details>
}

// splitBody lays the rows out in two columns, Before and After, with the line numbers and the added and removed cells
// highlighted.
templ splitBody(path string, hunks []state.Hunk) {
	<div class="diff-scroll">
		<table class="diff-table">
			<thead>
				<tr>
					<th class="diff-num"></th>
					<th class="diff-col-head">{ msgBefore.T(ctx) }</th>
					<th class="diff-num"></th>
					<th class="diff-col-head">{ msgAfter.T(ctx) }</th>
				</tr>
			</thead>
			<tbody>
				for _, hunk := range hunks {
					<tr class="diff-hunk-row">
						<td colspan="4">{ hunk.Header }</td>
					</tr>
					for _, row := range hunk.Rows {
						<tr>
							<td class="diff-num">{ cellNumber(row.Left) }</td>
							<td class={ cellClass(row.Left) }>@codeText(path, cellText(row.Left))</td>
							<td class="diff-num">{ cellNumber(row.Right) }</td>
							<td class={ cellClass(row.Right) }>@codeText(path, cellText(row.Right))</td>
						</tr>
					}
				}
			</tbody>
		</table>
	</div>
}

// unifiedBody lays the lines out in one column, with the old and the new line numbers and a sign.
templ unifiedBody(path string, hunks []state.Hunk) {
	<div class="diff-scroll">
		<table class="diff-table">
			<tbody>
				for _, hunk := range hunks {
					<tr class="diff-hunk-row">
						<td colspan="4">{ hunk.Header }</td>
					</tr>
					for _, line := range hunk.Lines {
						<tr>
							<td class="diff-num">{ lineNumber(line.OldNumber) }</td>
							<td class="diff-num">{ lineNumber(line.NewNumber) }</td>
							<td class="diff-sign">{ kindSign(line.Kind) }</td>
							<td class={ kindClass(line.Kind) }>@codeText(path, line.Text)</td>
						</tr>
					}
				}
			</tbody>
		</table>
	</div>
}

// codeText is the text of a code cell. The syntax highlighter finds it by data-code-text, picks the language from
// data-code-filename and replaces the plain text, which stays as the fallback. A blank cell has nothing to highlight.
templ codeText(path string, text string) {
	if text != "" {
		<span data-code-text={ text } data-code-filename={ path }>{ text }</span>
	}
}
