package components

import (
	shared "iworkflow/internal/core/components"
	"iworkflow/internal/modules/tasks/presentation/state"
)

// TaskHeader is the title of a task with its status, the workspace it belongs to (when its name is known), its failure
// and the time of its automatic resume. The notice of the last action of the page comes last.
templ TaskHeader(view state.TaskDetailView) {
	<div class="row justify-between gap-2">
		<h1 class="page-title min-w-0 truncate text-base md:text-xl">{ view.Task.Title }</h1>
		<div class="flex items-center gap-2">
			@TaskStatusBadge(view.Task.Status)
			if view.Task.Stage != state.StageBacklog {
				<span class="text-xs text-muted">{ msgLive.T(ctx) }</span>
			}
		</div>
	</div>
	if view.WorkspaceName != "" {
		<p class="truncate text-[11px] text-muted" data-task-workspace>{ msgWorkspacePrefix.T(ctx) }<span class="font-medium text-fg">{ view.WorkspaceName }</span></p>
	}
	if view.Task.Error != nil {
		@shared.ErrorText(*view.Task.Error)
	}
	if view.Task.Status == "rate_limited" && view.Task.ResumeAt != nil {
		<p class="text-xs text-muted">{ resumeNotice(ctx, view.Task.ResumeAt) }</p>
	}
	if view.Notice != "" {
		@shared.ErrorText(view.Notice)
	}
}
