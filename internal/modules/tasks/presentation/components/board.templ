package components

import (
	shared "iworkflow/internal/core/components"
	"iworkflow/internal/core/dock/link"
	"iworkflow/internal/modules/tasks/infrastructure/adapters/inbound/dto"
	"iworkflow/internal/modules/tasks/presentation/state"
)

// StageBadge is the stage label of a task. A working task shows a live dot.
templ StageBadge(stage string) {
	<span class={ "badge badge-" + stage }>
		if stage == state.StageWorking {
			<span class="live-dot"></span>
		}
		{ stageLabel(stage).T(ctx) }
	</span>
}

// activeActions are the buttons of an active or completed task card (loose card or graph node): open the task tab and,
// if available, its terminal.
templ activeActions(task dto.TaskDTO, scope string) {
	<div class="row justify-end gap-2">
		@link.Tab(link.Props{Href: state.TaskPath(task.ID), Class: "btn-ghost min-h-8 border border-fg/40 px-2.5 py-1 text-xs", Role: "button"}) {
			{ msgOpen.T(ctx) }
		}
		if task.Actions.CanOpenTerminal {
			@link.Tab(link.Props{Href: "/tasks/" + task.ID + "/terminal", Class: "btn-ghost min-h-8 px-2.5 py-1 text-xs", Role: "button"}) {
				{ msgTerminal.T(ctx) }
			}
		}
	</div>
}

// backlogActions are the card buttons of a backlog task, each shown only when its action is allowed: start,
// edit (opens the edit tab) and delete (asks first, as the Rust card does).
templ backlogActions(task dto.TaskDTO, scope string) {
	<div class="row justify-end gap-2">
		if task.Actions.CanStart {
			<button
				type="button"
				class="btn-primary min-h-8 px-2.5 py-1 text-xs"
				hx-post={ state.ScopedPath(state.BoardTaskPath(task.ID)+"/start", scope) }
				hx-swap="none"
				hx-disabled-elt="this"
			>{ msgStart.T(ctx) }</button>
		}
		if task.Actions.CanEdit {
			@link.Tab(link.Props{Href: state.TaskPath(task.ID) + "/edit", Class: "btn-ghost min-h-8 border border-fg/40 px-2.5 py-1 text-xs", Role: "button"}) {
				{ msgEdit.T(ctx) }
			}
		}
		if task.Actions.CanDelete {
			<button
				type="button"
				class="btn-ghost min-h-8 border border-fg/40 px-2.5 py-1 text-xs hover:bg-error/10 hover:text-error"
				hx-post={ state.ScopedPath(state.BoardTaskPath(task.ID)+"/delete", scope) }
				hx-confirm={ msgConfirmDelete.T(ctx) }
				hx-swap="none"
				hx-disabled-elt="this"
			>{ msgDelete.T(ctx) }</button>
		}
	</div>
}

// BoardToolbar is the bar over the list: the completed toggle and the create
// button. The form refreshes the list of its own board whenever one of its controls changes. Every target names
// the elements of this board instance (see state.Scoped), so another open board is never touched.
templ BoardToolbar(view state.BoardView) {
	<form
		id={ state.Scoped("board-controls", view.Scope) }
		class="flex shrink-0 flex-wrap items-center gap-x-4 gap-y-2 border-b border-border bg-surface px-4 py-2.5"
		hx-get="/board/frame"
		hx-target={ "#" + state.Scoped("board-list", view.Scope) }
		hx-swap="outerHTML"
		hx-trigger="change"
	>
		<input type="hidden" name="scope" value={ view.Scope }/>
		<input type="hidden" id={ state.Scoped("board-workspace", view.Scope) } name="workspace" value={ view.Choice.ID }/>
		<h1 class="page-title">{ msgBoard.T(ctx) }</h1>
		<div class="min-w-0 flex-1"></div>
		<label role="button" class={ toggleClass("btn-secondary cursor-pointer", view.ShowCompleted, "border-accent text-accent") }>
			<input type="checkbox" name="completed" value="1" class="sr-only" checked?={ view.ShowCompleted }/>
			<span aria-hidden="true">✓</span>
			<span class="hidden lg:inline">{ msgShowCompleted.T(ctx) }</span>
		</label>
		@link.Tab(link.Props{Href: state.NewTaskPath(view.Choice.ID), Class: "btn-primary", Title: msgNewTask.T(ctx), Role: "button"}) {
			<span class="text-lg leading-none">+</span>
			<span class="hidden sm:inline">{ msgNewTask.T(ctx) }</span>
		}
	</form>
}

// LoadFailed is the list of a board whose data could not be read. The error replaces the empty state, so a
// failed read never looks like a board with no tasks.
templ LoadFailed(message string) {
	<div class="stack items-center gap-3 p-8 text-center" role="alert">
		@shared.ErrorText(message)
	</div>
}

// BoardList is the list of the board, grouped by stage. It refreshes itself when the task stream says a
// task changed or was removed, and when a create dialog reports a new task (board:refresh). The refresh is a
// broadcast: every open board reloads its own list from its own address, so the refresh is harmless for the boards
// that are not shown. Its own attributes carry the address of the list, so the refresh keeps the workspace, the
// completed toggle and the instance.
// Stream notices are debounced (htmx "delay": 250 ms after the last one), so a burst ends in one refetch that sees the final
// state. "throttle" is not an option: htmx drops the events of its window, so the last change could be missed. The notices
// this list listens to (status, dialogs, exits) are not a continuous stream, so a quiet gap always comes.
// The element stays in the page: a refresh swaps only its content (innerHTML). Replacing the element would drop the
// task-stream events that arrive while the new one is not listening yet.
templ BoardList(view state.BoardView) {
	<div
		id={ state.Scoped("board-list", view.Scope) }
		class="board-list flex h-full w-full min-h-0 min-w-0 flex-1 flex-col overflow-hidden"
		hx-get={ state.ListPath(view.Scope, view.Choice.ID, view.ShowCompleted, view.Pages) }
		hx-trigger="sse:changed delay:250ms, sse:removed delay:250ms, sse:reset delay:250ms, board:refresh from:body"
		hx-sync="this:replace"
		hx-target="this"
		hx-swap="morph:innerHTML"
	>
		@BoardListBody(view)
	</div>
}

// BoardListBody is the content of the list: the stages, the empty state or the load error. It is what the list
// address answers.
templ BoardListBody(view state.BoardView) {
	if view.LoadError != "" {
		@LoadFailed(view.LoadError)
	} else {
		switch view.Choice.Kind {
			case state.ChoiceEmpty:
				<div class="stack items-center gap-3 p-8 text-center">
					<p class="muted">{ msgNoWorkspaces.T(ctx) }</p>
					<a href="/workspaces" class="btn-secondary">{ msgGoWorkspaces.T(ctx) }</a>
				</div>
			case state.ChoiceMissing:
				<p class="muted p-8 text-center">{ msgWorkspaceGone.T(ctx) }</p>
			case state.ChoiceSelected:
				if view.Total == 0 {
					<div class="stack items-center gap-3 p-8 text-center">
						<h2 class="text-sm font-semibold text-fg">{ msgEmptyTitle.T(ctx) }</h2>
						<p class="muted max-w-sm text-xs">{ msgEmptyHint.T(ctx) }</p>
						@link.Tab(link.Props{Href: state.NewTaskPath(view.Choice.ID), Class: "btn-primary", Role: "button"}) {
							{ msgCreateFirst.T(ctx) }
						}
					</div>
				} else {
					<div class="board-stages stack h-full min-h-0 gap-4 overflow-y-auto p-4" id={ state.Scoped("board-stages", view.Scope) }>
						for _, group := range view.Groups {
							if len(group.Tasks) > 0 {
								<section class="stack gap-2" data-stage-group={ group.Stage }>
									<h2 class="muted text-xs uppercase tracking-wide">{ stageLabel(group.Stage).T(ctx) } · { itoa(len(group.Tasks)) }</h2>
									<div class="grid gap-2" style="grid-template-columns: repeat(auto-fill, minmax(16rem, 1fr))">
										for _, task := range group.Tasks {
											@LooseTaskCard(task, view.Scope)
										}
									</div>
								</section>
							}
						}
						if view.HasMore {
							<button
								type="button"
								class="btn-secondary self-start text-xs px-3 py-1.5"
								hx-get={ state.ListPath(view.Scope, view.Choice.ID, view.ShowCompleted, view.Pages+1) }
								hx-target={ "#" + state.Scoped("board-list", view.Scope) }
								hx-swap="innerHTML"
							>
								{ msgLoadMoreDone.T(ctx) }
							</button>
						}
					</div>
				}
		}
	}
}

// BoardNotice is an out-of-band answer that shows one failure in the notice slot of its board instance (empty
// clears it).
templ BoardNotice(scope string, message string) {
	<div id={ state.Scoped("board-notice", scope) } hx-swap-oob="true">
		if message != "" {
			@shared.ErrorText(message)
		}
	</div>
}
