package components

import (
	shared "iworkflow/internal/core/components"
	"iworkflow/internal/core/dock/link"
	"iworkflow/internal/modules/tasks/infrastructure/adapters/inbound/dto"
	"iworkflow/internal/modules/tasks/presentation/state"
)

// StageBadge is the stage label of a task. A working task shows a live dot.
templ StageBadge(stage string) {
	<span class={ "badge badge-" + stage }>
		if stage == state.StageWorking {
			<span class="live-dot"></span>
		}
		{ stageLabel(stage).T(ctx) }
	</span>
}

// TaskCard is one task of the board: its title, its stage and its priority, linked to its detail. The scope is the
// board instance the card belongs to, so its actions answer there.
templ TaskCard(task dto.TaskDTO, scope string) {
	<li class="task-card" data-task-id={ task.ID } data-stage={ task.Stage }>
		<a href={ templ.SafeURL(state.TaskPath(task.ID)) } class="card stack gap-1.5 p-3 hover:border-accent">
			<div class="row justify-between gap-2">
				<span class="truncate text-sm font-semibold text-fg">{ state.TaskTitle(task) }</span>
				@StageBadge(task.Stage)
			</div>
			<div class="row gap-2 text-xs text-muted">
				<span>{ priorityLabel(task.Priority).T(ctx) }</span>
				if task.NeedsAttention {
					<span class="text-warn">{ stageLabel(state.StageAttention).T(ctx) }</span>
				}
			</div>
		</a>
		if task.Stage == state.StageBacklog {
			@backlogActions(task, scope)
		}
	</li>
}

// backlogActions are the card buttons of a backlog task, each shown only when its action is allowed: start,
// edit (opens the edit tab) and delete (asks first, as the Rust card does).
templ backlogActions(task dto.TaskDTO, scope string) {
	<div class="row justify-end gap-2">
		if task.Actions.CanStart {
			<button
				type="button"
				class="btn-primary min-h-8 px-2.5 py-1 text-xs"
				hx-post={ state.ScopedPath(state.BoardTaskPath(task.ID)+"/start", scope) }
				hx-swap="none"
				hx-disabled-elt="this"
			>{ msgStart.T(ctx) }</button>
		}
		if task.Actions.CanEdit {
			@link.Tab(link.Props{Href: state.TaskPath(task.ID) + "/edit", Class: "btn-ghost min-h-8 px-2.5 py-1 text-xs", Role: "button"}) {
				{ msgEdit.T(ctx) }
			}
		}
		if task.Actions.CanDelete {
			<button
				type="button"
				class="btn-ghost min-h-8 px-2.5 py-1 text-xs hover:bg-error/10 hover:text-error"
				hx-post={ state.ScopedPath(state.BoardTaskPath(task.ID)+"/delete", scope) }
				hx-confirm={ msgConfirmDelete.T(ctx) }
				hx-swap="none"
				hx-disabled-elt="this"
			>{ msgDelete.T(ctx) }</button>
		}
	</div>
}

// WorkspaceSwitcher is the workspace select of the toolbar, labelled by its title as the Rust switcher is.
// Changing it refreshes the list through the form that holds it (see BoardToolbar). It carries no
// aria-label of its own, so the "Workspace" label of the create dialog stays the only one with that name.
templ WorkspaceSwitcher(workspaces []dto.WorkspaceOptionDTO, selected string, id string) {
	<label class="select-pill max-w-xs" title={ msgSwitchWorkspace.T(ctx) }>
		<select id={ id } name="workspace" class="min-w-0 bg-transparent">
			if selected == "" {
				<option value="" selected>{ msgSelectWorkspace.T(ctx) }</option>
			}
			for _, workspace := range workspaces {
				<option value={ workspace.ID } selected?={ workspace.ID == selected }>{ workspace.Name + " (" + workspace.BaseBranch + ")" }</option>
			}
		</select>
	</label>
}

// BoardToolbar is the bar over the list: the workspace switcher, the completed toggle and the create
// button. The form refreshes the list of its own board whenever one of its controls changes. Every target names
// the elements of this board instance (see state.Scoped), so another open board is never touched.
templ BoardToolbar(view state.BoardView) {
	<form
		id={ state.Scoped("board-controls", view.Scope) }
		class="flex shrink-0 flex-wrap items-center gap-x-4 gap-y-2 border-b border-border bg-surface px-4 py-2.5"
		hx-get="/board/frame"
		hx-target={ "#" + state.Scoped("board-list", view.Scope) }
		hx-swap="outerHTML"
		hx-trigger="change"
	>
		<input type="hidden" name="scope" value={ view.Scope }/>
		<h1 class="page-title">{ msgBoard.T(ctx) }</h1>
		<div class="min-w-0 flex-1">
			@WorkspaceSwitcher(view.Workspaces, view.Choice.ID, state.Scoped("board-workspace", view.Scope))
		</div>
		<label role="button" class={ toggleClass("btn-secondary cursor-pointer", view.ShowCompleted, "border-accent text-accent") }>
			<input type="checkbox" name="completed" value="1" class="sr-only" checked?={ view.ShowCompleted }/>
			<span aria-hidden="true">✓</span>
			<span class="hidden lg:inline">{ msgShowCompleted.T(ctx) }</span>
		</label>
		<button
			type="button"
			class="btn-primary"
			hx-get={ state.ScopedPath("/board/tasks/new", view.Scope) }
			hx-include={ "#" + state.Scoped("board-workspace", view.Scope) }
			hx-target={ "#" + state.Scoped("board-create-slot", view.Scope) }
			hx-swap="innerHTML"
		>
			<span class="text-lg leading-none">+</span>
			<span class="hidden sm:inline">{ msgNewTask.T(ctx) }</span>
		</button>
	</form>
}

// LoadFailed is the list of a board whose data could not be read. The error replaces the empty state, so a
// failed read never looks like a board with no tasks.
templ LoadFailed(message string) {
	<div class="stack items-center gap-3 p-8 text-center" role="alert">
		@shared.ErrorText(message)
	</div>
}

// BoardList is the list of the board, grouped by stage. It refreshes itself when the task stream says a
// task changed or was removed, and when a create dialog reports a new task (board:refresh). The refresh is a
// broadcast: every open board reloads its own list from its own address, so the refresh is harmless for the boards
// that are not shown. Its own attributes carry the address of the list, so the refresh keeps the workspace, the
// completed toggle and the instance.
// The element stays in the page: a refresh swaps only its content (innerHTML). Replacing the element would drop the
// task-stream events that arrive while the new one is not listening yet.
templ BoardList(view state.BoardView) {
	<div
		id={ state.Scoped("board-list", view.Scope) }
		class="board-list"
		hx-get={ state.ListPath(view.Scope, view.Choice.ID, view.ShowCompleted, view.Pages) }
		hx-trigger="sse:changed, sse:removed, board:refresh from:body"
		hx-sync="this:replace"
		hx-target="this"
		hx-swap="innerHTML"
	>
		@BoardListBody(view)
	</div>
}

// BoardListBody is the content of the list: the stages, the empty state or the load error. It is what the list
// address answers.
templ BoardListBody(view state.BoardView) {
	if view.LoadError != "" {
		@LoadFailed(view.LoadError)
	} else {
		switch view.Choice.Kind {
			case state.ChoiceEmpty:
				<div class="stack items-center gap-3 p-8 text-center">
					<p class="muted">{ msgNoWorkspaces.T(ctx) }</p>
					<a href="/workspaces" class="btn-secondary">{ msgGoWorkspaces.T(ctx) }</a>
				</div>
			case state.ChoiceMissing:
				<p class="muted p-8 text-center">{ msgWorkspaceGone.T(ctx) }</p>
			case state.ChoiceSelected:
				if view.Total == 0 {
					<div class="stack items-center gap-3 p-8 text-center">
						<h2 class="text-sm font-semibold text-fg">{ msgEmptyTitle.T(ctx) }</h2>
						<p class="muted max-w-sm">{ msgEmptyHint.T(ctx) }</p>
						<button
							type="button"
							class="btn-primary"
							hx-get={ state.ScopedPath("/board/tasks/new", view.Scope) }
							hx-include={ "#" + state.Scoped("board-workspace", view.Scope) }
							hx-target={ "#" + state.Scoped("board-create-slot", view.Scope) }
							hx-swap="innerHTML"
						>
							{ msgCreateFirst.T(ctx) }
						</button>
					</div>
				}
				<div class="stack gap-4 p-4">
					for _, group := range view.Groups {
						if group.Stage != state.StageDone || view.ShowCompleted {
							<section class="stack gap-2" data-stage={ group.Stage }>
								<h2 class="flex items-center gap-2 text-xs font-semibold uppercase tracking-wide text-muted">
									@StageBadge(group.Stage)
									<span>{ count(len(group.Tasks)) }</span>
								</h2>
								if len(group.Tasks) > 0 {
									<ul class="grid gap-2 sm:grid-cols-2 xl:grid-cols-3">
										for _, task := range group.Tasks {
											@TaskCard(task, view.Scope)
										}
									</ul>
								}
							</section>
						}
					}
					if view.HasMore {
						<button
							type="button"
							class="btn-secondary self-center"
							hx-get={ state.FramePath(view.Scope, view.Choice.ID, true, view.Pages+1) }
							hx-target={ "#" + state.Scoped("board-list", view.Scope) }
							hx-swap="outerHTML"
						>
							{ msgLoadMoreDone.T(ctx) }
						</button>
					}
				</div>
		}
	}
}

// CreateTaskResult is the answer of a create. It is swapped into the dialog slot, which it empties (the dialog
// closes), so it must not repeat the slot id. The failures that happened after the task was created (its start,
// its dependencies) go to the notice slot of the same board instance, which the response clears out of band.
templ CreateTaskResult(scope string, startError string, linkErrors []string) {
	<div id={ state.Scoped("board-notice", scope) } hx-swap-oob="true">
		if startError != "" {
			@shared.ErrorText(msgStartFailed.Fmt(ctx, map[string]string{"error": startError}))
		}
		for _, linkError := range linkErrors {
			@shared.ErrorText(msgLinkFailedCreate.Fmt(ctx, map[string]string{"error": linkError}))
		}
	</div>
}

// BoardNotice is an out-of-band answer that shows one failure in the notice slot of its board instance (empty
// clears it).
templ BoardNotice(scope string, message string) {
	<div id={ state.Scoped("board-notice", scope) } hx-swap-oob="true">
		if message != "" {
			@shared.ErrorText(message)
		}
	</div>
}
