package components

import (
	shared "iworkflow/internal/core/components"
	"iworkflow/internal/modules/tasks/infrastructure/adapters/inbound/dto"
	"iworkflow/internal/modules/tasks/presentation/state"
)

// StageBadge is the stage label of a task. A working task shows a live dot.
templ StageBadge(stage string) {
	<span class={ "badge badge-" + stage }>
		if stage == state.StageWorking {
			<span class="live-dot"></span>
		}
		{ stageLabel(stage).T(ctx) }
	</span>
}

// TaskCard is one task of the board: its title, its stage and its priority, linked to its detail.
templ TaskCard(task dto.TaskDTO) {
	<li class="task-card" data-task-id={ task.ID } data-stage={ task.Stage }>
		<a href={ templ.SafeURL(state.TaskPath(task.ID)) } class="card stack gap-1.5 p-3 hover:border-accent">
			<div class="row justify-between gap-2">
				<span class="truncate text-sm font-semibold text-fg">{ state.TaskTitle(task) }</span>
				@StageBadge(task.Stage)
			</div>
			<div class="row gap-2 text-xs text-muted">
				<span>{ priorityLabel(task.Priority).T(ctx) }</span>
				if task.NeedsAttention {
					<span class="text-warn">{ stageLabel(state.StageAttention).T(ctx) }</span>
				}
			</div>
		</a>
	</li>
}

// WorkspaceSwitcher is the workspace select of the toolbar, labelled by its title as the Rust switcher is.
// Changing it refreshes the list through the form that holds it (see BoardToolbar). It carries no
// aria-label of its own, so the "Workspace" label of the create dialog stays the only one with that name.
templ WorkspaceSwitcher(workspaces []dto.WorkspaceOptionDTO, selected string) {
	<label class="select-pill max-w-xs" title={ msgSwitchWorkspace.T(ctx) }>
		<select name="workspace" class="min-w-0 bg-transparent">
			if selected == "" {
				<option value="" selected>{ msgSelectWorkspace.T(ctx) }</option>
			}
			for _, workspace := range workspaces {
				<option value={ workspace.ID } selected?={ workspace.ID == selected }>{ workspace.Name + " (" + workspace.BaseBranch + ")" }</option>
			}
		</select>
	</label>
}

// BoardToolbar is the bar over the list: the workspace switcher, the completed toggle and the create
// button. The form refreshes the list whenever one of its controls changes.
templ BoardToolbar(view state.BoardView) {
	<form
		id="board-controls"
		class="flex shrink-0 flex-wrap items-center gap-x-4 gap-y-2 border-b border-border bg-surface px-4 py-2.5"
		hx-get="/board/list"
		hx-target="#board-list"
		hx-swap="outerHTML"
		hx-trigger="change"
	>
		<h1 class="page-title">{ msgBoard.T(ctx) }</h1>
		<div class="min-w-0 flex-1">
			@WorkspaceSwitcher(view.Workspaces, view.Choice.ID)
		</div>
		<label class={ toggleClass("btn-secondary cursor-pointer", view.ShowCompleted, "border-accent text-accent") }>
			<input type="checkbox" name="completed" value="1" class="sr-only" checked?={ view.ShowCompleted }/>
			<span aria-hidden="true">✓</span>
			<span class="hidden lg:inline">{ msgShowCompleted.T(ctx) }</span>
		</label>
		<button
			type="button"
			class="btn-primary"
			hx-get="/board/tasks/new"
			hx-include="[name='workspace']"
			hx-target="#board-create-slot"
			hx-swap="innerHTML"
		>
			<span class="text-lg leading-none">+</span>
			<span class="hidden sm:inline">{ msgNewTask.T(ctx) }</span>
		</button>
	</form>
}

// BoardList is the list of the board, grouped by stage. It refreshes itself when the task stream says a
// task changed or was removed, and when a create dialog reports a new task (board:refresh). Its own
// attributes carry the address of the list, so the refresh keeps the workspace and the completed toggle.
templ BoardList(view state.BoardView) {
	<div
		id="board-list"
		class="board-list"
		hx-get={ state.ListPath(view.Choice.ID, view.ShowCompleted, view.Pages) }
		hx-trigger="sse:changed, sse:removed, board:refresh from:body"
		hx-target="this"
		hx-swap="outerHTML"
	>
		switch view.Choice.Kind {
			case state.ChoiceEmpty:
				<div class="stack items-center gap-3 p-8 text-center">
					<p class="muted">{ msgNoWorkspaces.T(ctx) }</p>
					<a href="/workspaces" class="btn-secondary">{ msgGoWorkspaces.T(ctx) }</a>
				</div>
			case state.ChoiceMissing:
				<p class="muted p-8 text-center">{ msgWorkspaceGone.T(ctx) }</p>
			case state.ChoiceSelected:
				if view.Total == 0 {
					<div class="stack items-center gap-3 p-8 text-center">
						<h2 class="text-sm font-semibold text-fg">{ msgEmptyTitle.T(ctx) }</h2>
						<p class="muted max-w-sm">{ msgEmptyHint.T(ctx) }</p>
						<button type="button" class="btn-primary" hx-get="/board/tasks/new" hx-include="[name='workspace']" hx-target="#board-create-slot" hx-swap="innerHTML">
							{ msgCreateFirst.T(ctx) }
						</button>
					</div>
				}
				<div class="stack gap-4 p-4">
					for _, group := range view.Groups {
						if group.Stage != state.StageDone || view.ShowCompleted {
							<section class="stack gap-2" data-stage={ group.Stage }>
								<h2 class="flex items-center gap-2 text-xs font-semibold uppercase tracking-wide text-muted">
									@StageBadge(group.Stage)
									<span>{ count(len(group.Tasks)) }</span>
								</h2>
								if len(group.Tasks) > 0 {
									<ul class="grid gap-2 sm:grid-cols-2 xl:grid-cols-3">
										for _, task := range group.Tasks {
											@TaskCard(task)
										}
									</ul>
								}
							</section>
						}
					}
					if view.HasMore {
						<button
							type="button"
							class="btn-secondary self-center"
							hx-get={ state.ListPath(view.Choice.ID, true, view.Pages+1) }
							hx-target="#board-list"
							hx-swap="outerHTML"
						>
							{ msgLoadMoreDone.T(ctx) }
						</button>
					}
				</div>
		}
		if view.LoadError != "" {
			@shared.ErrorText(view.LoadError)
		}
	</div>
}

// CreateTaskDialog is the create dialog: workspace, optional title, prompt, priority and the start toggle.
// Submitting it replaces the slot with CreateTaskResult; an error keeps the dialog open with the message.
templ CreateTaskDialog(form state.CreateForm) {
	@shared.Modal(shared.ModalProps{Title: msgNewTask.T(ctx), Open: true}) {
		<form class="stack gap-3" hx-post="/board/tasks" hx-target="#board-create-slot" hx-swap="innerHTML" hx-disabled-elt="find button[type=submit]">
			<label class="stack gap-1.5">
				<span class="text-sm font-medium text-fg">{ msgWorkspace.T(ctx) }</span>
				<select class="input" name="workspace_id" required aria-label={ msgWorkspace.T(ctx) }>
					if form.WorkspaceID == "" {
						<option value="" selected>{ msgSelectWorkspace.T(ctx) }</option>
					}
					for _, workspace := range form.Workspaces {
						<option value={ workspace.ID } selected?={ workspace.ID == form.WorkspaceID }>{ workspace.Name + " (" + workspace.BaseBranch + ")" }</option>
					}
				</select>
			</label>
			@shared.TextField(shared.FieldProps{Label: msgTitleOptional.T(ctx), Name: "title", Value: form.Title})
			@shared.TextArea(shared.FieldProps{Label: msgPrompt.T(ctx), Name: "prompt", Value: form.Prompt, Placeholder: msgPromptHint.T(ctx), Required: true, Large: true})
			@shared.SelectField(shared.SelectFieldProps{Label: msgPriority.T(ctx), Name: "priority", Value: form.Priority, Options: priorityOptions(ctx)})
			<label class="row min-h-10 items-center gap-2 text-sm text-fg">
				<input type="checkbox" name="start_now" value="on" checked?={ form.StartNow }/>
				<span>{ msgStartNow.T(ctx) }</span>
			</label>
			if form.Error != "" {
				@shared.ErrorText(form.Error)
			}
			<div class="row justify-end gap-2">
				<button type="button" class="btn-ghost" hx-get="/board/tasks/new/close" hx-target="#board-create-slot" hx-swap="innerHTML">{ msgCancel.T(ctx) }</button>
				<button type="submit" class="btn-primary">{ msgCreateTask.T(ctx) }</button>
			</div>
		</form>
	}
}

// CreateTaskResult is the answer of a create: the dialog slot is emptied (the dialog closes) and, when
// the task was created but its start failed (startError), the notice is shown in the board's notice slot.
templ CreateTaskResult(startError string) {
	<div id="board-create-slot"></div>
	<div id="board-notice" hx-swap-oob="true">
		if startError != "" {
			@shared.ErrorText(msgStartFailed.Fmt(ctx, map[string]string{"error": startError}))
		}
	</div>
}
