package components

import (
	coreui "iworkflow/internal/core/components"
	"iworkflow/internal/modules/tasks/presentation/state"
)

// TaskTabRegion is the strip of the detail tabs of a task and the body of the active tab. The region is one element:
// each tab swaps it for its own body, and the body of a tab that stays on screen is not reloaded by another one.
templ TaskTabRegion(tabs state.TaskTabs, body templ.Component) {
	<div id={ tabs.RegionID() } class="flex min-h-0 max-h-[40vh] shrink-0 flex-col">
		@coreui.TabBar(taskTabItems(ctx, tabs), tabs.Active)
		<div class="stack min-h-0 overflow-y-auto p-4">
			@body
		</div>
	</div>
}

// TaskActionsBody is the Acciones tab: the actions of the task, its context and its images.
templ TaskActionsBody(view state.TaskDetailView) {
	@TaskActions(view)
	@TaskContext(view)
	@TaskAttachmentsList(view.Attachments, view.AttachmentsError)
}
