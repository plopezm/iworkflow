package components

import (
	"strconv"

	coreui "iworkflow/internal/core/components"
	"iworkflow/internal/modules/tasks/presentation/state"
)

// TaskFileEditor is the inline editor of one file of the diff view. A save writes the file and commits it on the task
// branch, and the status line tells whether the text differs from the content that was loaded.
templ TaskFileEditor(view state.FileEditor) {
	<div id={ view.SlotID() } class="diff-editor">
		<form class="stack p-3" hx-post={ view.SavePath() } hx-target={ "#" + view.SlotID() } hx-swap="innerHTML">
			<input type="hidden" name="scope" value={ view.Scope }/>
			<input type="hidden" name="path" value={ view.Path }/>
			<input type="hidden" name="base" value={ view.Digest }/>
			<input type="hidden" name="eol" value={ view.EOL }/>
			<textarea
				name="content"
				class="diff-editor-input"
				rows={ strconv.Itoa(view.Rows()) }
				spellcheck="false"
				aria-label={ msgFileContent.T(ctx) }
				hx-post={ view.StatePath() }
				hx-include="closest form"
				hx-trigger="input changed delay:400ms"
				hx-target={ "#" + view.StatusID() }
				hx-swap="innerHTML"
			>{ textareaText(view.Content) }</textarea>
			if view.Error != "" {
				@coreui.ErrorText(view.Error)
			}
			if view.Unchanged {
				<p class="notice notice-info animate-fade-in">{ msgUnchanged.T(ctx) }</p>
			}
			<div class="flex flex-wrap items-center gap-2">
				<button type="submit" class="btn-primary">{ msgSaveFile.T(ctx) }</button>
				<button type="button" class="btn-ghost" hx-get={ view.ClosePath() } hx-target={ "#" + view.SlotID() } hx-swap="innerHTML">{ msgCancel.T(ctx) }</button>
				<span id={ view.StatusID() } class="muted text-xs"></span>
				<span class="muted ml-auto text-xs">{ msgSaveHint.T(ctx) }</span>
			</div>
		</form>
	</div>
}

// TaskFileStatus is the status line of the editor: it names the unsaved changes, and is empty when there are none.
templ TaskFileStatus(dirty bool) {
	if dirty {
		{ msgUnsavedChanges.T(ctx) }
	}
}
