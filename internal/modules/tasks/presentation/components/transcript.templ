package components

import (
	shared "iworkflow/internal/core/components"
	"iworkflow/internal/modules/tasks/presentation/state"
)

// TranscriptPanel is the conversation of the task on its detail page. The scroller opens the task stream after the
// cursor, and the body inside it listens to the stream: a refresh answers TranscriptBody and morphs only the body, so open details and selections survive, so
// the element that listens stays in the page and the events that arrive meanwhile are not lost.
templ TranscriptPanel(view state.TaskDetailView) {
	<div
		id={ state.Scoped("task-transcript-scroll", view.Scope) }
		class="min-h-0 flex-1 overflow-y-auto p-4"
		hx-ext="sse,morph"
		sse-connect={ state.TaskEventsPath(view.Task.ID, view.TranscriptCursor) }
	>
		<div
			id={ state.Scoped("task-transcript", view.Scope) }
			class="transcript stack"
			hx-get={ state.TranscriptPath(view.Task.ID) }
			hx-trigger="sse:message delay:300ms"
			hx-sync="this:replace"
			hx-target="this"
			hx-swap="morph:innerHTML"
			data-follow-bottom
		>
			if view.TranscriptError != "" {
				@shared.ErrorText(view.TranscriptError)
			} else {
				@TranscriptBody(view.Task.ID, view.Transcript)
			}
		</div>
	</div>
}

// TranscriptBody is the content of the transcript: its items in order, or the note that there is no activity yet.
// It is what the refresh answers. The task id is what a pending dialog answers to.
templ TranscriptBody(taskID string, transcript state.Transcript) {
	if len(transcript.Items) == 0 {
		<p class="muted">{ msgTranscriptNoActivity.T(ctx) }</p>
	}
	for index, item := range transcript.Items {
		<div id={ transcriptItemID(taskID, index) } class="contents">
			@transcriptItem(taskID, item)
		</div>
	}
}

templ transcriptUser(item state.UserItem) {
	<div class="msg msg-user">
		<span class="msg-role">{ msgTranscriptRoleUser.T(ctx) }</span>
		if item.Images > 0 {
			<span class="msg-attachments">{ imagesLabel(ctx, item.Images) }</span>
		}
		if item.Text != "" {
			<pre class="whitespace-pre-wrap break-words">{ item.Text }</pre>
		}
	</div>
}

templ transcriptAssistant(item state.AssistantItem) {
	<div class="msg msg-assistant">
		<span class="msg-role">{ msgTranscriptRoleAgent.T(ctx) }</span>
		if item.Thinking != nil {
			<details class="thinking">
				<summary>{ msgTranscriptReasoning.T(ctx) }</summary>
				<pre class="whitespace-pre-wrap break-words">{ *item.Thinking }</pre>
			</details>
		}
		if item.Text != "" {
			<div class="markdown">@templ.Raw(markdownHTML(item.Text))</div>
		}
		if item.Error != nil {
			@shared.ErrorText(*item.Error)
		}
	</div>
}

templ transcriptTool(item state.ToolItem) {
	<details class={ toolClass(ctx, item) }>
		<summary>{ toolSummary(ctx, item) }</summary>
		<dl class="tool-args">
			for _, row := range argRows(item.Args) {
				<div class="tool-arg">
					if row.Key != "" {
						<dt>{ row.Key }</dt>
					}
					<dd>
						if isBlockArg(row.Value) {
							<pre class="whitespace-pre-wrap break-words">{ row.Value }</pre>
						} else {
							<code>{ row.Value }</code>
						}
					</dd>
				</div>
			}
		</dl>
		if item.Output != "" {
			<pre class="tool-output whitespace-pre-wrap break-words">{ item.Output }</pre>
		}
	</details>
}

templ transcriptNotice(item state.NoticeItem) {
	if isLaunchNotice(item.Message) {
		<details class={ noticeClass(item.Level) }>
			<summary class="cursor-pointer">{ msgTranscriptLaunchDetails.T(ctx) }</summary>
			<pre class="mt-2 font-mono text-[11px] break-all whitespace-pre-wrap">{ item.Message }</pre>
		</details>
	} else {
		<div class={ noticeClass(item.Level) }>{ item.Message }</div>
	}
}

templ transcriptStatus(item state.StatusItem) {
	<div class="status-line">
		@TaskStatusBadge(item.Status)
		if item.Error != nil {
			<span class="muted">{ *item.Error }</span>
		}
	</div>
}

templ transcriptExit(item state.ExitItem) {
	<div class="status-line muted">{ exitText(ctx, item) }</div>
}
