package components

import (
	"context"
	"strconv"

	shared "iworkflow/internal/core/components"
	"iworkflow/internal/core/i18n"
	"iworkflow/internal/modules/tasks/domain/models"
	"iworkflow/internal/modules/tasks/presentation/state"
)

// FinishPreview is the dialog a finish asks through: the confirmation and, when processes use the worktree, one checked
// checkbox per process. Checked processes are closed before the commit; unchecked ones keep running. Cancel only closes
// the dialog. Finalizar posts the finish to the task, which answers the page of this instance.
templ FinishPreview(view state.FinishPreviewView) {
	@shared.Modal(shared.ModalProps{Title: msgFinishAndReview.T(ctx), Open: true, ID: state.Scoped("finish-panel", view.Scope)}) {
		<p class="text-sm text-fg">{ msgConfirmFinish.T(ctx) }</p>
		<form
			class="stack gap-3"
			hx-post={ state.FinishActionPath(view.TaskID, view.Scope) }
			hx-target={ "#" + state.Scoped("task-detail", view.Scope) }
			hx-swap="outerHTML"
			data-task-finish
		>
			if len(view.Processes) > 0 {
				<p class="text-sm font-medium text-fg">{ msgFinishProcessesTitle.T(ctx) }</p>
				<p class="text-xs text-muted">{ msgFinishProcessesHint.T(ctx) }</p>
				<ul class="stack max-h-[40vh] gap-2 overflow-y-auto">
					for _, process := range view.Processes {
						<li>
							<label class="row min-h-10 items-start gap-2 text-sm text-fg">
								<input type="checkbox" name="process" value={ process.Value } checked class="mt-1 h-5 w-5"/>
								<span class="stack gap-0.5">
									<span>{ process.Name } · PID { strconv.Itoa(process.PID) }</span>
									<span class="text-xs text-muted">{ finishReasonLabel(ctx, process.Reason) }</span>
									<span class="break-all text-xs text-muted">{ process.Path }</span>
								</span>
							</label>
						</li>
					}
				</ul>
			}
			<div class="row justify-end gap-2">
				<button type="button" class="btn-secondary" data-modal-close>{ msgCancel.T(ctx) }</button>
				<button type="submit" class="btn-primary" hx-disabled-elt="this">{ msgFinishConfirmButton.T(ctx) }</button>
			</div>
		</form>
	}
}

// finishReasonLabel is the human reason a process uses the worktree: its working directory, an executable, or a file.
func finishReasonLabel(ctx context.Context, reason string) string {
	switch reason {
	case models.ProcessReasonWorkingDirectory:
		return msgReasonWorkingDirectory.T(ctx)
	case models.ProcessReasonExecutable:
		return msgReasonExecutable.T(ctx)
	case models.ProcessReasonOpenFile:
		return msgReasonOpenFile.T(ctx)
	default:
		return reason
	}
}

var (
	msgFinishConfirmButton  = i18n.Msg{En: "Finish", Es: "Finalizar", Zh: "完成", De: "Abschließen", Fr: "Terminer"}
	msgFinishProcessesTitle = i18n.Msg{En: "Processes using the worktree", Es: "Procesos que usan el worktree", Zh: "正在使用工作树的进程", De: "Prozesse, die den Worktree verwenden", Fr: "Processus qui utilisent le worktree"}
	msgFinishProcessesHint  = i18n.Msg{En: "Checked processes will be closed. Unchecked ones keep running.", Es: "Los procesos marcados se cerrarán. Los desmarcados seguirán en marcha.", Zh: "勾选的进程将被关闭，未勾选的继续运行。", De: "Markierte Prozesse werden beendet. Nicht markierte laufen weiter.", Fr: "Les processus cochés seront fermés. Les autres continuent de tourner."}
	msgReasonWorkingDirectory = i18n.Msg{En: "working directory", Es: "directorio de trabajo", Zh: "工作目录", De: "Arbeitsverzeichnis", Fr: "répertoire de travail"}
	msgReasonExecutable       = i18n.Msg{En: "executable", Es: "ejecutable", Zh: "可执行文件", De: "ausführbare Datei", Fr: "exécutable"}
	msgReasonOpenFile         = i18n.Msg{En: "open file", Es: "archivo abierto", Zh: "已打开的文件", De: "geöffnete Datei", Fr: "fichier ouvert"}
)
