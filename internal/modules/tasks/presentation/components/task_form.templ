package components

import (
	"context"

	shared "iworkflow/internal/core/components"
	"iworkflow/internal/modules/tasks/infrastructure/adapters/inbound/dto"
	"iworkflow/internal/modules/tasks/presentation/state"
)

// acceptedImages is the accept list of the image inputs: the MIME types the domain stores.
const acceptedImages = "image/png,image/jpeg,image/gif,image/webp"

// maxImageMiB is the size limit of one image, shown next to the picker.
const maxImageMiB = "4"

// BranchSelect is the base branch select, with the workspace base branch as its first choice. The create dialog
// replaces the whole select when the workspace changes, so it is a fragment with its own id.
templ BranchSelect(id string, choices []state.BranchChoice, value string, defaultBranch string) {
	<div id={ id }>
		<label class="stack gap-1.5">
			<span class="text-sm font-medium text-fg">{ msgBaseBranch.T(ctx) }</span>
			<select class="input" name="base_branch">
				<option value="" selected?={ value == "" }>{ msgWorkspaceBranch.Fmt(ctx, map[string]string{"branch": defaultBranch}) }</option>
				for _, choice := range choices {
					<option value={ choice.Name } selected?={ choice.Name == value }>{ branchLabel(ctx, choice) }</option>
				}
			</select>
		</label>
	</div>
}

// branchLabel is the text of a branch option: remote branches say so.
func branchLabel(ctx context.Context, choice state.BranchChoice) string {
	if choice.Remote {
		return msgRemoteBranch.Fmt(ctx, map[string]string{"name": choice.Name})
	}
	return choice.Name
}

// ImagePicker is the image input of the create and edit forms. Selected images are previewed by the page script
// (web/static/js/task_images.js), which also takes images pasted into the prompt.
templ ImagePicker() {
	<div class="stack gap-2" data-image-picker>
		<label class="btn-secondary self-start cursor-pointer" title={ msgAttachImages.Fmt(ctx, map[string]string{"mib": maxImageMiB}) }>
			<span>{ msgAttach.T(ctx) }</span>
			<input type="file" name="images" multiple accept={ acceptedImages } class="sr-only" data-image-input/>
		</label>
		<div class="flex flex-wrap gap-2" data-image-previews></div>
	</div>
}

// ExistingAttachments lists the images the task already has. Each one has a checkbox that removes it on save.
templ ExistingAttachments(items []dto.TaskAttachmentDTO) {
	if len(items) > 0 {
		<fieldset class="stack gap-2">
			<legend class="text-sm font-medium text-fg">{ msgAttachedImages.T(ctx) }</legend>
			<div class="flex flex-wrap gap-2">
				for _, item := range items {
					<label class="stack items-center gap-1 text-xs text-muted">
						<img src={ item.URL } alt={ item.Name } class="h-16 w-16 rounded object-cover"/>
						<span class="row items-center gap-1">
							<input type="checkbox" name="remove_attachment_ids" value={ item.ID } aria-label={ msgRemoveImage.Fmt(ctx, map[string]string{"name": item.Name}) }/>
							<span>{ msgDelete.T(ctx) }</span>
						</span>
					</label>
				}
			</div>
		</fieldset>
	}
}

// LimitFields are the optional RAM and CPU caps of a task behind an "Advanced options" toggle, as the Rust form
// has them. The limits count only while the toggle is on; an empty field means the default from the settings.
// The page script shows and hides the block (data-toggle-target), so the block keeps what was typed.
templ LimitFields(id string, advanced bool, memory string, cpu string) {
	<label class="row min-h-10 items-center gap-2 text-sm text-fg">
		<input type="checkbox" name="show_advanced" value="on" class="h-5 w-5" checked?={ advanced } data-toggle-target={ id }/>
		<span>{ msgAdvancedOptions.T(ctx) }</span>
	</label>
	<div id={ id } class="stack gap-3" hidden?={ !advanced }>
		@shared.NumberField(shared.NumberFieldProps{Label: msgMaxRAM.T(ctx), Name: "memory_limit_mb", Unit: "MiB", Placeholder: msgDefaultFromSet.T(ctx), Value: memory})
		@shared.NumberField(shared.NumberFieldProps{Label: msgMaxCPU.T(ctx), Name: "cpu_limit_percent", Unit: msgPercentOfCore.T(ctx), Placeholder: msgDefaultFromSet.T(ctx), Value: cpu})
	</div>
}

// CreateTaskDialog is the create dialog: workspace, base branch, title, prompt, images, priority, the advanced
// limits and the start toggle. A linked create hides the start toggle, because a linked task waits for its
// predecessors. Submitting replaces the slot with CreateTaskResult; an error keeps the dialog open.
templ CreateTaskDialog(form state.CreateForm) {
	@shared.Modal(shared.ModalProps{Title: msgNewTask.T(ctx), Open: true}) {
		<form class="stack gap-3" hx-post="/board/tasks" hx-encoding="multipart/form-data" hx-target="#board-create-slot" hx-swap="innerHTML" hx-disabled-elt="find button[type=submit]">
			if form.LinkKind != "" {
				<input type="hidden" name="link_kind" value={ form.LinkKind }/>
				<input type="hidden" name="link_anchor" value={ form.LinkAnchor }/>
			}
			<label class="stack gap-1.5">
				<span class="text-sm font-medium text-fg">{ msgWorkspace.T(ctx) }</span>
				<select
					class="input"
					name="workspace_id"
					required
					aria-label={ msgWorkspace.T(ctx) }
					hx-get="/board/tasks/branches"
					hx-target="#board-branch-slot"
					hx-swap="outerHTML"
					hx-trigger="change"
				>
					if form.WorkspaceID == "" {
						<option value="" selected>{ msgSelectWorkspace.T(ctx) }</option>
					}
					for _, workspace := range form.Workspaces {
						<option value={ workspace.ID } selected?={ workspace.ID == form.WorkspaceID }>{ workspace.Name + " (" + workspace.BaseBranch + ")" }</option>
					}
				</select>
			</label>
			@BranchSelect("board-branch-slot", branchChoices(form), form.BaseBranch, form.DefaultBranch)
			@shared.TextField(shared.FieldProps{Label: msgTitleOptional.T(ctx), Name: "title", Value: form.Title, Placeholder: msgDerivedFromPrompt.T(ctx)})
			@shared.TextArea(shared.FieldProps{Label: msgPrompt.T(ctx), Name: "prompt", Value: form.Prompt, Placeholder: msgPromptHint.T(ctx), Required: true, Large: true, Attrs: templ.Attributes{"data-image-paste": ""}})
			@ImagePicker()
			@shared.SelectField(shared.SelectFieldProps{Label: msgPriority.T(ctx), Name: "priority", Value: form.Priority, Options: priorityOptions(ctx)})
			@LimitFields("board-advanced-limits", form.ShowAdvanced, form.MemoryLimit, form.CPULimit)
			if form.LinkKind == "" {
				<label class="row min-h-10 items-center gap-2 text-sm text-fg">
					<input type="checkbox" name="start_now" value="on" class="h-5 w-5" checked?={ form.StartNow }/>
					<span>{ msgStartNow.T(ctx) }</span>
				</label>
			}
			if form.Error != "" {
				@shared.ErrorText(form.Error)
			}
			<div class="row justify-end gap-2">
				<button type="button" class="btn-ghost" hx-get="/board/tasks/new/close" hx-target="#board-create-slot" hx-swap="innerHTML">{ msgCancel.T(ctx) }</button>
				<button type="submit" class="btn-primary">{ msgCreateTask.T(ctx) }</button>
			</div>
		</form>
	}
}

// branchChoices are the base branch options of a create form.
func branchChoices(form state.CreateForm) []state.BranchChoice {
	return state.BranchChoices(form.Branches, form.BaseBranch)
}

// TaskEditFields are the editable fields of a backlog task. The edit page wraps them in its own form.
templ TaskEditFields(form state.EditForm) {
	@shared.TextField(shared.FieldProps{Label: msgTitleOptional.T(ctx), Name: "title", Value: form.Title, Placeholder: msgDerivedFromPrompt.T(ctx)})
	@BranchSelect("task-edit-branch", state.BranchChoices(form.Branches, form.BaseBranch), form.BaseBranch, form.DefaultBranch)
	@shared.SelectField(shared.SelectFieldProps{Label: msgPriority.T(ctx), Name: "priority", Value: form.Priority, Options: priorityOptions(ctx)})
	@LimitFields("task-edit-advanced-limits", form.ShowAdvanced, form.MemoryLimit, form.CPULimit)
	@shared.TextArea(shared.FieldProps{Label: msgPrompt.T(ctx), Name: "prompt", Value: form.Prompt, Placeholder: msgPromptHint.T(ctx), Required: true, Large: true, Attrs: templ.Attributes{"data-image-paste": ""}})
	@ExistingAttachments(form.Existing)
	@ImagePicker()
}

// TaskSaved is the answer of a save of the edit page. It names the board to return to: the page script closes
// the edit tab and opens that board (the data-dock-leave hook), as the Rust page does.
templ TaskSaved(boardPath string) {
	<p class="sr-only" data-dock-leave={ boardPath }></p>
}

// TaskEditResult is the answer of a failed save: the error, shown in place of the result.
templ TaskEditResult(message string) {
	@shared.ErrorText(message)
}

// BranchSlotFailed replaces the base branch select when the branches of the workspace cannot be read.
templ BranchSlotFailed(id string, message string) {
	<div id={ id }>
		@shared.ErrorText(message)
	</div>
}

// NotEditable is the answer of the edit page for a task that left backlog.
templ NotEditable() {
	@shared.ErrorText(msgTaskNotEditable.T(ctx))
}

// EditTitle is the title of the edit tab.
func EditTitle(ctx context.Context) string {
	return msgEditTask.T(ctx)
}
