package components

import (
	"context"

	shared "iworkflow/internal/core/components"
	"iworkflow/internal/core/dock/link"
	"iworkflow/internal/core/i18n"
	"iworkflow/internal/modules/tasks/domain/ports/outbound"
	"iworkflow/internal/modules/tasks/infrastructure/adapters/inbound/dto"
	"iworkflow/internal/modules/tasks/presentation/state"
)

// acceptedImages is the accept list of the image inputs: the MIME types the domain stores.
const acceptedImages = "image/png,image/jpeg,image/gif,image/webp"

// maxImageMiB is the size limit of one image, shown next to the picker.
const maxImageMiB = "4"

// BranchSelect is the base branch select, with the workspace base branch as its first choice. The create dialog
// replaces the whole select when the workspace changes, so it is a fragment with its own id.
templ BranchSelect(id string, choices []state.BranchChoice, value string, defaultBranch string) {
	<div id={ id }>
		<label class="stack gap-1.5">
			<span class="text-sm font-medium text-fg">{ msgBaseBranch.T(ctx) }</span>
			<select class="input" name="base_branch">
				<option value="" selected?={ value == "" }>{ msgWorkspaceBranch.Fmt(ctx, map[string]string{"branch": defaultBranch}) }</option>
				for _, choice := range choices {
					<option value={ choice.Name } selected?={ choice.Name == value }>{ branchLabel(ctx, choice) }</option>
				}
			</select>
		</label>
	</div>
}

// RelatedProjectsField is the "Related projects" field: a button that opens a dialog to choose the workspaces the task
// may relate to, with a filter, and a summary of the chosen ones. The dialog holds one checkbox per workspace, each with
// its path in muted text; it stays inside the form, so the chosen checkboxes are submitted even when it is closed. The
// checkbox value and its data-workspace-id are the workspace id; the create page hides the row of the workspace the task
// belongs to (web/static/js/task_form.js, which also filters the rows and keeps the summary). It renders nothing when
// there is no other workspace.
templ RelatedProjectsField(projects []state.RelatedProjectChoice) {
	if len(projects) > 0 {
		<div class="stack gap-2" data-related-projects>
			<span class="text-sm font-medium text-fg">{ msgRelatedProjects.T(ctx) }</span>
			<p class="text-xs text-muted">{ msgRelatedProjectsHint.T(ctx) }</p>
			<div class="row flex-wrap items-center gap-2">
				<button type="button" class="btn-secondary self-start" data-related-open>
					<span>{ msgChooseProjects.T(ctx) }</span>
					<span class="text-xs text-muted" data-related-count></span>
				</button>
				<ul class="flex flex-wrap gap-1" data-related-summary></ul>
			</div>
			@shared.Modal(shared.ModalProps{Title: msgRelatedProjects.T(ctx), Open: false}) {
				<input type="search" class="input" placeholder={ msgFilterProjects.T(ctx) } aria-label={ msgFilterProjects.T(ctx) } autocomplete="off" data-related-filter/>
				<div class="stack max-h-[50vh] overflow-y-auto" data-related-list>
					for _, project := range projects {
						<label class="row min-h-10 items-center gap-2 text-sm text-fg" data-related-row data-related-name={ project.Name } data-related-text={ project.Name + " " + project.Path }>
							<input type="checkbox" name="related_project_id" value={ project.ID } data-workspace-id={ project.ID } class="h-5 w-5" checked?={ project.Selected }/>
							<span class="stack gap-0.5">
								<span>{ project.Name }</span>
								<span class="text-xs text-muted">{ project.Path }</span>
							</span>
						</label>
					}
					<p class="text-sm text-muted" data-related-empty hidden>{ msgNoProjects.T(ctx) }</p>
				</div>
				<div class="row justify-end">
					<button type="button" class="btn-primary" data-modal-close>{ msgDone.T(ctx) }</button>
				</div>
			}
		</div>
	}
}

// branchLabel is the text of a branch option: remote branches say so.
func branchLabel(ctx context.Context, choice state.BranchChoice) string {
	if choice.Remote {
		return msgRemoteBranch.Fmt(ctx, map[string]string{"name": choice.Name})
	}
	return choice.Name
}

// ImagePicker is the image input of the create and edit forms. Selected images are previewed by the page script
// (web/static/js/task_images.js), which also takes images pasted into the prompt.
templ ImagePicker() {
	<div class="stack gap-2" data-image-picker>
		<label class="btn-secondary self-start cursor-pointer" title={ msgAttachImages.Fmt(ctx, map[string]string{"mib": maxImageMiB}) }>
			<span>{ msgAttach.T(ctx) }</span>
			<input type="file" name="images" multiple accept={ acceptedImages } class="sr-only" data-image-input/>
		</label>
		<div class="flex flex-wrap gap-2" data-image-previews data-remove-label={ msgRemoveImage.T(ctx) }></div>
	</div>
}

// ExistingAttachments lists the images the task already has. Each one has a button that marks it for removal on save (through a hidden checkbox).
templ ExistingAttachments(items []dto.TaskAttachmentDTO) {
	if len(items) > 0 {
		<fieldset class="stack gap-2">
			<legend class="text-sm font-medium text-fg">{ msgAttachedImages.T(ctx) }</legend>
			<div class="flex flex-wrap gap-2">
				for _, item := range items {
					<div class="relative" data-existing-image>
						<img src={ item.URL } alt={ item.Name } class="h-16 w-16 rounded object-cover"/>
						<input type="checkbox" name="remove_attachment_ids" value={ item.ID } class="sr-only" tabindex="-1" aria-hidden="true"/>
						<button type="button" class="composer-ref-remove absolute -right-1 -top-1" data-existing-image-toggle aria-pressed="false" aria-label={ msgRemoveImage.Fmt(ctx, map[string]string{"name": item.Name}) }>×</button>
					</div>
				}
			</div>
		</fieldset>
	}
}

// AdvancedOptions renders the collapsible "Advanced options" section with agent, model, effort, profile
// selectors as the first option, followed by the RAM and CPU resource limits.
templ AdvancedOptions(id string, scope string, advanced bool, memory string, cpu string, agent state.AgentFormState) {
	<label class="row min-h-10 items-center gap-2 text-sm text-fg">
		<input type="checkbox" name="show_advanced" value="on" class="h-5 w-5" checked?={ advanced } data-toggle-target={ id }/>
		<span>{ msgAdvancedOptions.T(ctx) }</span>
	</label>
	<div id={ id } class="stack gap-3" hidden?={ !advanced }>
		<label class="stack gap-1.5">
			<span class="text-sm font-medium text-fg">{ msgAgent.T(ctx) }</span>
			<select
				class="input"
				name="agent_runtime"
				aria-label={ msgAgent.T(ctx) }
				hx-get={ state.ScopedPath("/board/tasks/agent-options", scope) }
				hx-target={ "#" + state.Scoped("task-agent-options", scope) }
				hx-swap="innerHTML"
				hx-trigger="change"
				hx-disabled-elt="this"
			>
				<option value="" selected?={ agent.SelectedRuntime == "" }>{ agentDefaultLabel(ctx, agent.Catalog.DefaultRuntime) }</option>
				for _, rt := range agent.Catalog.Runtimes {
					<option value={ rt } selected?={ agent.SelectedRuntime == rt }>{ rt }</option>
				}
			</select>
		</label>
		<div id={ state.Scoped("task-agent-options", scope) } class="stack gap-3">
			@AgentOptionsFields(scope, agent)
		</div>
		@shared.NumberField(shared.NumberFieldProps{Label: msgMaxRAM.T(ctx), Name: "memory_limit_mb", Unit: "MiB", Placeholder: msgDefaultFromSet.T(ctx), Value: memory})
		@shared.NumberField(shared.NumberFieldProps{Label: msgMaxCPU.T(ctx), Name: "cpu_limit_percent", Unit: msgPercentOfCore.T(ctx), Placeholder: msgDefaultFromSet.T(ctx), Value: cpu})
	</div>
}

// AgentOptionsFields renders the dependent agent selectors (model, thinking, profile) that the selected
// agent supports. Any unsupported option is not shown.
templ AgentOptionsFields(scope string, agent state.AgentFormState) {
	if agent.Catalog.SupportsModels && len(agent.Catalog.Models) > 0 {
		@shared.SelectField(shared.SelectFieldProps{
			Label:       msgModel.T(ctx),
			Name:        "agent_model",
			Value:       agent.SelectedModel,
			Placeholder: modelPlaceholder(ctx, agent.Catalog.DefaultModel),
			Options:     modelFormOptions(agent.Catalog.Models),
		})
	}
	if agent.Catalog.SupportsThinking && len(agent.Catalog.ThinkingLevels) > 0 {
		@shared.SelectField(shared.SelectFieldProps{
			Label:       msgThinking.T(ctx),
			Name:        "agent_thinking",
			Value:       agent.SelectedThinking,
			Placeholder: thinkingPlaceholder(ctx, agent.Catalog.DefaultThinking),
			Options:     thinkingFormOptions(ctx, agent.Catalog.ThinkingLevels),
		})
	}
	if agent.Catalog.SupportsProfiles && len(agent.Catalog.Profiles) > 0 {
		@shared.SelectField(shared.SelectFieldProps{
			Label:       msgProfile.T(ctx),
			Name:        "agent_profile",
			Value:       agent.SelectedProfile,
			Placeholder: profilePlaceholder(ctx, agent.Catalog.DefaultProfile),
			Options:     profileFormOptions(agent.Catalog.Profiles),
		})
	}
}

// LimitFields are the optional RAM and CPU caps of a task behind an "Advanced options" toggle.
templ LimitFields(id string, advanced bool, memory string, cpu string) {
	@AdvancedOptions(id, "", advanced, memory, cpu, state.AgentFormState{})
}

// CreateTaskFields are the fields of the create page: workspace, base branch, related projects, title, prompt, images,
// priority, the advanced limits and the start toggle. A linked create hides the start toggle, because a linked task
// waits for its predecessors. The create page wraps them in its own form.
templ CreateTaskFields(form state.CreateForm) {
	if form.LinkKind != "" {
		<input type="hidden" name="link_kind" value={ form.LinkKind }/>
		<input type="hidden" name="link_anchor" value={ form.LinkAnchor }/>
	}
	<label class="stack gap-1.5">
		<span class="text-sm font-medium text-fg">{ msgWorkspace.T(ctx) }</span>
		<select
			class="input"
			name="workspace_id"
			required
			aria-label={ msgWorkspace.T(ctx) }
			hx-get={ state.ScopedPath("/board/tasks/branches", form.Scope) }
			hx-target={ "#" + state.Scoped("board-branch-slot", form.Scope) }
			hx-swap="outerHTML"
			hx-trigger="change"
			hx-disabled-elt="this"
		>
			if form.WorkspaceID == "" {
				<option value="" selected>{ msgSelectWorkspace.T(ctx) }</option>
			}
			for _, workspace := range form.Workspaces {
				<option value={ workspace.ID } selected?={ workspace.ID == form.WorkspaceID }>{ workspace.Name + " (" + workspace.BaseBranch + ")" }</option>
			}
		</select>
	</label>
	@BranchSelect(state.Scoped("board-branch-slot", form.Scope), branchChoices(form), form.BaseBranch, form.DefaultBranch)
	@RelatedProjectsField(form.RelatedProjects)
	@shared.TextField(shared.FieldProps{Label: msgTitleOptional.T(ctx), Name: "title", Value: form.Title, Placeholder: msgDerivedFromPrompt.T(ctx)})
	@TaskPromptField(msgPrompt.T(ctx), state.Scoped("board-create-prompt", form.Scope), form.Prompt, "/board/tasks/composer/files")
	@ImagePicker()
	@shared.SelectField(shared.SelectFieldProps{Label: msgPriority.T(ctx), Name: "priority", Value: form.Priority, Options: priorityOptions(ctx)})
	@AdvancedOptions(state.Scoped("board-advanced-limits", form.Scope), form.Scope, form.ShowAdvanced, form.MemoryLimit, form.CPULimit, form.Agent)
	if form.LinkKind == "" {
		<label class="row min-h-10 items-center gap-2 text-sm text-fg">
			<input type="checkbox" name="start_now" value="on" class="h-5 w-5" checked?={ form.StartNow }/>
			<span>{ msgStartNow.T(ctx) }</span>
		</label>
	}
}

// TaskCreated is the answer of a create. A clean create ends the create tab and opens the board of the workspace (the
// data-dock-leave hook). A failure after the task was created (its start, its dependencies) keeps the tab, so the
// user reads it, and offers the way to the board.
templ TaskCreated(boardPath string, startError string, linkErrors []string) {
	if startError == "" && len(linkErrors) == 0 {
		<p class="sr-only" data-dock-leave={ boardPath }></p>
	} else {
		if startError != "" {
			@shared.ErrorText(msgStartFailed.Fmt(ctx, map[string]string{"error": startError}))
		}
		for _, linkError := range linkErrors {
			@shared.ErrorText(msgLinkFailedCreate.Fmt(ctx, map[string]string{"error": linkError}))
		}
		@link.Tab(link.Props{Href: boardPath, Class: "btn-secondary self-start", Role: "button"}) {
			{ msgBoard.T(ctx) }
		}
	}
}

// CreateTitle is the title of the create tab.
func CreateTitle(ctx context.Context) string {
	return msgNewTask.T(ctx)
}

// branchChoices are the base branch options of a create form.
func branchChoices(form state.CreateForm) []state.BranchChoice {
	return state.BranchChoices(form.Branches, form.BaseBranch)
}

// TaskEditFields are the editable fields of a backlog task. The edit page wraps them in its own form.
templ TaskEditFields(form state.EditForm) {
	@shared.TextField(shared.FieldProps{Label: msgTitleOptional.T(ctx), Name: "title", Value: form.Title, Placeholder: msgDerivedFromPrompt.T(ctx)})
	@BranchSelect(state.Scoped("task-edit-branch", form.Scope), state.BranchChoices(form.Branches, form.BaseBranch), form.BaseBranch, form.DefaultBranch)
	@RelatedProjectsField(form.RelatedProjects)
	@shared.SelectField(shared.SelectFieldProps{Label: msgPriority.T(ctx), Name: "priority", Value: form.Priority, Options: priorityOptions(ctx)})
	@AdvancedOptions(state.Scoped("task-edit-advanced-limits", form.Scope), form.Scope, form.ShowAdvanced, form.MemoryLimit, form.CPULimit, form.Agent)
	@TaskPromptField(msgPrompt.T(ctx), state.Scoped("task-edit-prompt", form.Scope), form.Prompt, state.TaskPath(form.TaskID)+"/composer/files")
	@ExistingAttachments(form.Existing)
	@ImagePicker()
}

// TaskPromptField renders the prompt textarea with @ file completion, reference chips and voice dictation, matching the
// chat composer. The mic records audio and the review panel lets the user listen to it before it is transcribed
// (web/static/js/dictation.js); the labels the script shows are carried by the data attributes of the root.
templ TaskPromptField(label string, id string, value string, filesPath string) {
	<div
		class="stack gap-1.5 composer"
		data-composer
		data-files-path={ filesPath }
		data-remove-label={ msgRemoveReference.T(ctx) }
		data-dictation
		data-dictation-path="/transcriptions"
		data-label-record={ msgDictationRecord.T(ctx) }
		data-label-stop={ msgDictationStop.T(ctx) }
		data-label-recording={ msgDictationRecording.T(ctx) }
		data-label-question={ msgDictationQuestion.T(ctx) }
		data-label-confirm={ msgDictationConfirm.T(ctx) }
		data-label-discard={ msgDictationDiscard.T(ctx) }
		data-label-transcribing={ msgDictationTranscribing.T(ctx) }
		data-label-unsupported={ msgDictationUnsupported.T(ctx) }
		data-label-denied={ msgDictationDenied.T(ctx) }
		data-label-error={ msgDictationError.T(ctx) }
	>
		<label class="text-sm font-medium text-fg" for={ id }>
			{ label }
		</label>
		<div class="composer-field relative" data-composer-field>
			<ul class="composer-menu" role="listbox" aria-label={ msgSuggestions.T(ctx) } data-composer-menu hidden></ul>
			<textarea
				id={ id }
				name="prompt"
				class="input input-lg resize-y"
				placeholder={ msgPromptHint.T(ctx) }
				required
				data-composer-input
				data-image-paste
			>{ value }</textarea>
			<button
				type="button"
				class="composer-mic"
				aria-label={ msgDictationRecord.T(ctx) }
				aria-pressed="false"
				title={ msgDictationRecord.T(ctx) }
				data-dictation-mic
			>
				<svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
					<rect x="9" y="3" width="6" height="12" rx="3"></rect>
					<path d="M5 11a7 7 0 0 0 14 0"></path>
					<path d="M12 18v3"></path>
				</svg>
				<span class="composer-mic-time" data-dictation-elapsed hidden></span>
			</button>
			<span class="composer-grip" data-composer-grip aria-hidden="true"></span>
		</div>
		<div class="stack gap-2 rounded-md border border-border bg-surface p-3 text-sm" data-dictation-panel hidden>
			<p class="text-muted" role="status" aria-live="polite" data-dictation-status></p>
			<audio class="w-full" controls hidden data-dictation-audio></audio>
			<p class="font-medium text-fg" data-dictation-question hidden></p>
			<div class="row flex-wrap gap-2" data-dictation-actions hidden>
				<button type="button" class="btn-primary" data-dictation-confirm></button>
				<button type="button" class="btn-ghost" data-dictation-discard></button>
			</div>
		</div>
		<ul class="composer-refs flex flex-wrap gap-1" data-composer-refs hidden></ul>
	</div>
}

// TaskSaved is the answer of a save of the edit page. It names the board to return to: the page script closes
// the edit tab and opens that board (the data-dock-leave hook), as the Rust page does.
templ TaskSaved(boardPath string) {
	<p class="sr-only" data-dock-leave={ boardPath }></p>
}

// TaskEditResult is the answer of a failed save: the error, shown in place of the result.
templ TaskEditResult(message string) {
	@shared.ErrorText(message)
}

// BranchSlotFailed replaces the base branch select when the branches of the workspace cannot be read.
templ BranchSlotFailed(id string, message string) {
	<div id={ id }>
		@shared.ErrorText(message)
	</div>
}

// NotEditable is the answer of the edit page for a task that left backlog.
templ NotEditable() {
	@shared.ErrorText(msgTaskNotEditable.T(ctx))
}

// EditTitle is the title of the edit tab.
func EditTitle(ctx context.Context) string {
	return msgEditTask.T(ctx)
}

func agentDefaultLabel(ctx context.Context, defaultRuntime string) string {
	if defaultRuntime != "" {
		return msgDefaultRuntime.Fmt(ctx, map[string]string{"runtime": defaultRuntime})
	}
	return msgDefault.T(ctx)
}

func modelPlaceholder(ctx context.Context, defaultModel string) string {
	if defaultModel != "" {
		return msgDefault.T(ctx) + " (" + defaultModel + ")"
	}
	return msgDefault.T(ctx)
}

func thinkingPlaceholder(ctx context.Context, defaultThinking string) string {
	if defaultThinking != "" {
		return msgDefault.T(ctx) + " (" + thinkingLabel(ctx, defaultThinking) + ")"
	}
	return msgDefault.T(ctx)
}

func profilePlaceholder(ctx context.Context, defaultProfile string) string {
	if defaultProfile != "" {
		return msgDefault.T(ctx) + " (" + defaultProfile + ")"
	}
	return msgDefault.T(ctx)
}

func modelFormOptions(models []outbound.AgentModelOption) []shared.FormOption {
	options := make([]shared.FormOption, 0, len(models))
	for _, m := range models {
		val := m.Model
		label := m.Model
		if m.Provider != "" {
			val = m.Provider + "/" + m.Model
			label = m.Provider + "/" + m.Model
		}
		options = append(options, shared.FormOption{Value: val, Label: label})
	}
	return options
}

func thinkingFormOptions(ctx context.Context, levels []string) []shared.FormOption {
	options := make([]shared.FormOption, 0, len(levels))
	for _, id := range levels {
		options = append(options, shared.FormOption{Value: id, Label: thinkingLabel(ctx, id)})
	}
	return options
}

func profileFormOptions(profiles []string) []shared.FormOption {
	options := make([]shared.FormOption, 0, len(profiles))
	for _, p := range profiles {
		options = append(options, shared.FormOption{Value: p, Label: p})
	}
	return options
}

func thinkingLabel(ctx context.Context, id string) string {
	labels := map[string]i18n.Msg{
		"off":     msgThinkingOff,
		"minimal": msgThinkingMinimal,
		"low":     msgThinkingLow,
		"medium":  msgThinkingMedium,
		"high":    msgThinkingHigh,
		"xhigh":   msgThinkingXHigh,
		"max":     msgThinkingMax,
	}
	if label, known := labels[id]; known {
		return label.T(ctx)
	}
	return id
}
