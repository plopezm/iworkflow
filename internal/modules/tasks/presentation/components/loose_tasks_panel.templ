package components

import (
	shared "iworkflow/internal/core/components"
	"iworkflow/internal/modules/tasks/infrastructure/adapters/inbound/dto"
)

templ LooseTasksPanel(loose []dto.TaskDTO, scope string, collapsed bool) {
	@shared.CollapsiblePanel(shared.CollapsiblePanelProps{
		Title:         msgLooseTitle.T(ctx),
		Count:         len(loose),
		Collapsed:     collapsed,
		ExpandLabel:   msgLooseExpand.T(ctx),
		CollapseLabel: msgLooseCollapse.T(ctx),
	}) {
		if len(loose) == 0 {
			<div class="empty-hint p-4 text-center">
				<p class="font-medium text-fg">{ msgLooseEmptyTitle.T(ctx) }</p>
				<p class="mt-1 text-xs text-muted">{ msgLooseEmptyHint.T(ctx) }</p>
			</div>
		} else {
			<div class="loose-list flex flex-col gap-2 p-2">
				for _, task := range loose {
					@LooseTaskCard(task, scope)
				}
			</div>
		}
	}
}
