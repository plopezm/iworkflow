package components

import ui "iworkflow/internal/core/components"

// PruneSettingID is the id of the card; the checkbox swaps the whole card with the server's answer.
const PruneSettingID = "prune-merged-setting"

// PruneSettingPath loads the card and receives the checkbox change.
const PruneSettingPath = "/tasks/prune-merged"

// PruneSettingProps configures the card. Error is the message of a failed read or save.
type PruneSettingProps struct {
	Title   string
	Label   string
	Help    string
	Enabled bool
	Error   string
}

// PruneSettingCard is the card with the checkbox that switches the automatic deletion of old merged tasks.
templ PruneSettingCard(p PruneSettingProps) {
	<div id={ PruneSettingID }>
		@ui.Card(p.Title) {
			if p.Error != "" {
				@ui.ErrorText(p.Error)
			}
			<p class="muted text-sm">{ p.Help }</p>
			<label class="row items-center gap-2 text-sm text-fg">
				<input
					type="checkbox"
					name="enabled"
					value="true"
					class="h-4 w-4"
					checked?={ p.Enabled }
					hx-post={ PruneSettingPath }
					hx-trigger="change"
					hx-target={ "#" + PruneSettingID }
					hx-swap="outerHTML"
				/>
				{ p.Label }
			</label>
		}
	</div>
}
