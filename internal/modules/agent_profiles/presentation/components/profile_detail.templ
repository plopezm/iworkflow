package components

import (
	coreui "iworkflow/internal/core/components"
	"iworkflow/internal/modules/agent_profiles/presentation/state"
)

// ProfileDetail is the card of the selected profile: its actions, the delete confirmation, the
// catalog error and the routing editor. It is the swap target of every action on the profile.
templ ProfileDetail(detail state.DetailView, oob bool) {
	<div id="profiles-detail" class="stack" { oobAttrs(oob)... }>
		if !detail.Present {
			<p class="muted">{ msgCreateOrImport.T(ctx) }</p>
		} else {
			@coreui.Card("") {
				<div class="row flex-wrap justify-between gap-2">
					<h2 class="card-title">{ detail.Name }</h2>
					<div class="row flex-wrap gap-2">
						<button type="button" class="btn-secondary" hx-get={ detail.DuplicateURL } hx-target="#profiles-dialog" hx-swap="outerHTML">{ msgDuplicate.T(ctx) }</button>
						<button type="button" class="btn-secondary" hx-get={ detail.RenameURL } hx-target="#profiles-dialog" hx-swap="outerHTML">{ msgRename.T(ctx) }</button>
						<span class="contents" hx-get={ detail.ExportNoticeURL } hx-swap="none">
							<a class="btn-secondary" role="button" href={ templ.SafeURL(detail.ExportURL) } download={ detail.Filename }>{ msgExport.T(ctx) }</a>
						</span>
						<button type="button" class="btn-secondary" hx-get={ detail.JSONURL } hx-target="#profiles-json" hx-swap="innerHTML">{ msgCopyJSON.T(ctx) }</button>
						<button type="button" class="btn-danger" hx-get={ detail.DetailURL + "?confirm=delete" } hx-target="#profiles-detail" hx-swap="outerHTML">{ msgDelete.T(ctx) }</button>
					</div>
				</div>
				if detail.Active {
					<p class="muted text-sm">{ msgIsActive.T(ctx) }</p>
				}
				<div id="profiles-json"></div>
				if detail.ConfirmDelete {
					@coreui.ConfirmPanel(
						msgDeleteConfirm.Fmt(ctx, deleteMessageArgs(detail.Name)),
						msgDelete.T(ctx),
						false,
						templ.Attributes{
							"hx-delete": deleteURLWithSelection(detail.DeleteURL, detail.Selected),
							"hx-target": "#profiles-detail",
							"hx-swap":   "outerHTML",
						},
						templ.Attributes{
							"hx-get":    detail.DetailURL,
							"hx-target": "#profiles-detail",
							"hx-swap":   "outerHTML",
						},
					)
				}
				if detail.Error != "" {
					@coreui.ErrorText(detail.Error)
				}
				@RoutingEditor(detail.Routing)
			}
		}
	</div>
}

// DetailError replaces the detail card with a message, for a request that cannot show the profile.
templ DetailError(message string) {
	<div id="profiles-detail" class="stack">
		@coreui.ErrorText(message)
	</div>
}
