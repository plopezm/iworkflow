package pages

import (
	shared "iworkflow/internal/core/components"
	"iworkflow/internal/modules/terminal/presentation/components"
	"iworkflow/internal/modules/terminal/presentation/state"
)

// TerminalsPage is the sessions list: the header with the actions, the notice of an opened session
// and the table of sessions.
templ TerminalsPage(list state.ListView) {
	<div class="flex h-full min-h-0 flex-col">
		<div class="flex shrink-0 items-center justify-between border-b border-border bg-surface px-4 py-2.5">
			<h1 class="page-title">{ msgTerminals.T(ctx) }</h1>
			<div class="row gap-1.5">
				<button
					type="button"
					class="btn-primary min-h-8 px-2.5 py-1 text-xs"
					hx-post="/terminal/home"
					hx-target="#terminal-open-status"
					hx-swap="innerHTML"
					hx-disabled-elt="this"
				>{ msgNewHomeTerminal.T(ctx) }</button>
				<button
					type="button"
					class="btn-secondary min-h-8 px-2.5 py-1 text-xs"
					hx-get="/terminal/sessions"
					hx-target="#terminal-sessions"
					hx-swap="outerHTML"
				>{ msgRefresh.T(ctx) }</button>
			</div>
		</div>
		<div class="stack min-h-0 flex-1 overflow-y-auto p-4">
			<div id="terminal-open-status"></div>
			@shared.Card(msgSessions.T(ctx)) {
				@components.SessionsList(list)
			}
		</div>
	</div>
}
