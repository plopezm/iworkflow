package pages

import "iworkflow/internal/modules/workspace_groups/presentation/state"

// GroupsPage is the groups tab: the way back to Workspaces, the form that creates a group and the list of groups.
// The list reloads itself on board:refresh (a group was created, deleted or changed), morphing in place.
templ GroupsPage(_ state.GroupsPage) {
	<div class="flex h-full min-h-0 flex-col">
		<div class="shrink-0 border-b border-border bg-surface px-4 py-2.5">
			@breadcrumbNav(crumbs(ctx, ""))
		</div>
		<div class="stack min-h-0 flex-1 overflow-y-auto p-4">
			<form class="row gap-2" hx-post="/workspace-groups" hx-swap="none" data-group-create>
				<input type="text" name="name" class="input min-w-0 flex-1" placeholder={ msgNewName.T(ctx) } aria-label={ msgNewName.T(ctx) } required autocomplete="off"/>
				<button type="submit" class="btn-primary">{ msgCreate.T(ctx) }</button>
			</form>
			<div
				id={ state.ListTargetID }
				class="stack"
				hx-get={ state.ListFragmentPath }
				hx-trigger="load, board:refresh from:body"
				hx-sync="this:replace"
				hx-swap="morph:innerHTML"
			></div>
		</div>
	</div>
}
