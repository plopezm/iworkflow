package components

import "iworkflow/internal/modules/usage_limits/presentation/state"

// UsageBarPlaceholder is the element that loads the usage bar with htmx on page load. The shell renders it
// in the sidebar footer, just above the agent settings bar. The first answer replaces the placeholder (outerHTML, not
// a morph): the bar is a new element with its own 60 second poll, and htmx processes its triggers only when it is new.
templ UsageBarPlaceholder() {
	<div id={ BarID } hx-get={ BarPath } hx-trigger="load, every 15s [!document.hidden]" hx-swap="outerHTML"></div>
}

// UsageBar is the usage bar. Its root keeps polling every 60 seconds even when the bar is hidden, so a provider that
// becomes configured later shows up without a reload. The poll pauses while the browser tab is hidden, so a
// background tab does not take one of the few connections a browser opens per origin.
templ UsageBar(bar state.BarState) {
	<div
		id={ BarID }
		class={ templ.KV("hidden", bar.Hidden) }
		hx-get={ BarPath }
		hx-trigger="every 60s [!document.hidden]"
		hx-sync="this:replace"
		hx-swap="morph:outerHTML"
	>
		if !bar.Hidden {
			<div class="flex flex-col divide-y divide-border/50 rounded-lg border border-border bg-surface-2/60 px-1.5 py-1 font-mono text-[10px] leading-4">
				for _, provider := range bar.Providers {
					@usageProvider(provider)
				}
				for _, name := range bar.Unavailable {
					<p class="py-0.5 text-muted" data-usage-unavailable>{ unavailableText(ctx, name) }</p>
				}
			</div>
		}
	</div>
}

// usageProvider is one provider: its name on the left and one line per window on the right.
templ usageProvider(provider state.ProviderState) {
	<div class="flex items-start gap-1.5 py-0.5 first:pt-0 last:pb-0" data-usage-provider={ provider.ID }>
		<div class="flex w-12 shrink-0 flex-col">
			<span class="font-semibold text-fg">{ provider.Name }</span>
			if provider.Stale {
				<span class="text-warn" data-usage-stale title={ msgStale.T(ctx) }>
					<span aria-hidden="true">⚠</span>
					<span class="sr-only">{ msgStale.T(ctx) }</span>
				</span>
			}
		</div>
		<div class="flex min-w-0 flex-1 flex-col">
			for _, window := range provider.Windows {
				@usageWindowRow(window)
			}
		</div>
	</div>
}

// usageWindowRow is one window: its label, a progress track, the percentage and the time to the reset.
templ usageWindowRow(window state.WindowState) {
	<div class="flex items-center gap-1.5" data-usage-window={ window.Name } data-level={ window.Level }>
		<span class="w-12 shrink-0 truncate text-muted">{ windowLabel(ctx, window.Name) }</span>
		<div class="h-1 min-w-0 flex-1 overflow-hidden rounded-full bg-border/50">
			@usageFill(window)
		</div>
		<span class="w-8 shrink-0 text-right tabular-nums">{ percentText(window.Pct) }</span>
		if window.HasReset {
			<span class="min-w-12 shrink-0 whitespace-nowrap text-right text-muted">↻ { resetText(window.ResetIn) }</span>
		}
	</div>
}

// usageFill is the filled part of a track. Its color follows the level; the classes are literal here so
// Tailwind generates them.
templ usageFill(window state.WindowState) {
	switch window.Level {
	case "critical":
		<div class="h-full rounded-full bg-error" style={ fillStyle(window.Pct) }></div>
	case "warn":
		<div class="h-full rounded-full bg-warn" style={ fillStyle(window.Pct) }></div>
	default:
		<div class="h-full rounded-full bg-ok" style={ fillStyle(window.Pct) }></div>
	}
}
